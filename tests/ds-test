    done
    _assert_file_exists "host key: first concurrent start reaches the reserved prelaunch phase" \
      "$concurrent_ready"
    set +e
    concurrent_second_output=$(BLOCK_UPTERM_SCAN=0 _share_start "concurrent-second" 2>&1)
    concurrent_second_rc=$?
    set -e
    _assert_exit "host key: a concurrent start cannot replace in-flight trust" \
      1 "$concurrent_second_rc"
