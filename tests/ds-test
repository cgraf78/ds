# Tests: Share TTL watcher
# ---------------------------------------------------------------------------

echo ""
echo "=== Share TTL watcher ==="

DS_UNSHARE_LOG="$MOCK_BIN/ds-unshare.log"
cat >"$MOCK_BIN/ds" <<MOCK
#!/usr/bin/env bash
printf 'expected=%s expiry=%s args=%s\n' \
  "\${DS_UPTERM_EXPECTED_TOKEN:-}" "\${DS_UPTERM_TTL_EXPIRY_TOKEN:-}" "\$*" \
  >>"${DS_UNSHARE_LOG}"
MOCK
chmod +x "$MOCK_BIN/ds"

_reset_tmux_log
DS_UPTERM_PID_FILE="$(_upterm_pid_file)"
DS_UPTERM_SHARE_TTL=""
: >"$DS_UNSHARE_LOG"
ttl_token_a=11111111111111111111111111111111
ttl_token_b=22222222222222222222222222222222
ttl_control_a=$(_upterm_ttl_control_dir "$ttl_token_a")

ttl_old_umask=$(umask)
umask 000
_upterm_start_ttl_watcher 60 "ds" "$ttl_token_a"
umask "$ttl_old_umask"
_assert_file_exists "watcher: token-scoped watcher state is created" \
  "$ttl_control_a/watcher"
ttl_watcher_pid=""
# shellcheck disable=SC2034 # The reader requires an identity output variable.
ttl_watcher_identity=""
ttl_watcher_token=""
_upterm_read_pid_file "$ttl_control_a/watcher" \
  ttl_watcher_pid ttl_watcher_identity ttl_watcher_token
_assert_eq "watcher: process state carries the lifecycle token" \
  "$ttl_token_a" "$ttl_watcher_token"
ttl_dir_mode=$(stat -c '%a' "$ttl_control_a" 2>/dev/null || stat -f '%Lp' "$ttl_control_a")
ttl_file_mode=$(stat -c '%a' "$ttl_control_a/watcher" 2>/dev/null || stat -f '%Lp' "$ttl_control_a/watcher")
_assert_eq "watcher: control directory is private under umask 000" "700" "$ttl_dir_mode"
_assert_eq "watcher: state file is private under umask 000" "600" "$ttl_file_mode"

ttl_signal_audit="$(_tmpdir)/signals"
saved_ttl_kill=$(declare -f kill 2>/dev/null || true)
# shellcheck disable=SC2329 # Production cancellation would invoke this audit double.
kill() {
  [[ "${1:-}" == -0 ]] || printf '%s\n' "$*" >>"$ttl_signal_audit"
  command kill "$@"
}
_upterm_cancel_ttl_watcher "$ttl_token_a"
unset -f kill
[[ -z "$saved_ttl_kill" ]] || eval "$saved_ttl_kill"
_assert_file_missing "watcher: acknowledged cancellation removes exact state" \
  "$ttl_control_a"
if [[ ! -s "$ttl_signal_audit" ]]; then
  _pass "watcher: cancellation never signals a recovered PID or process group"
else
  _fail "watcher: cancellation signaled recovered state: $(<"$ttl_signal_audit")"
fi
for ((ttl_attempt = 0; ttl_attempt < 500; ttl_attempt++)); do
  command kill -0 "$ttl_watcher_pid" 2>/dev/null || break
  sleep 0.01
done
if command kill -0 "$ttl_watcher_pid" 2>/dev/null; then
  _fail "watcher: cooperative cancellation exits the watcher"
else
  _pass "watcher: cooperative cancellation exits the watcher"
fi

_upterm_cancel_ttl_watcher "$ttl_token_a"
_pass "watcher: cancellation is idempotent when exact state is absent"

_upterm_start_ttl_watcher 60 "ds" "$ttl_token_a"
ttl_first_pid=""
ttl_first_identity=""
ttl_first_token=""
_upterm_read_pid_file "$ttl_control_a/watcher" \
  ttl_first_pid ttl_first_identity ttl_first_token
_assert_eq "watcher: reset source state has the exact token" \
  "$ttl_token_a" "$ttl_first_token"
if _upterm_ttl_watcher_matches \
  "$ttl_first_pid" "$ttl_first_identity" "$ttl_token_a"; then
  _pass "watcher: reset source names the exact watcher"
else
  _fail "watcher: reset source does not name the exact watcher"
fi
_upterm_start_ttl_watcher 60 "ds" "$ttl_token_a"
ttl_second_pid=""
ttl_second_identity=""
ttl_second_token=""
_upterm_read_pid_file "$ttl_control_a/watcher" \
  ttl_second_pid ttl_second_identity ttl_second_token
_assert_eq "watcher: reset replacement state has the exact token" \
  "$ttl_token_a" "$ttl_second_token"
if _upterm_ttl_watcher_matches \
  "$ttl_second_pid" "$ttl_second_identity" "$ttl_token_a"; then
  _pass "watcher: reset replacement names the exact watcher"
else
  _fail "watcher: reset replacement does not name the exact watcher"
fi
if [[ "$ttl_first_pid" != "$ttl_second_pid" ]]; then
  _pass "watcher: reset replaces the exact token's watcher"
else
  _fail "watcher: reset did not replace the exact token's watcher"
fi
for ((ttl_attempt = 0; ttl_attempt < 500; ttl_attempt++)); do
  command kill -0 "$ttl_first_pid" 2>/dev/null || break
  sleep 0.01
done
if command kill -0 "$ttl_first_pid" 2>/dev/null; then
  _fail "watcher: reset waits for cooperative cancellation"
else
  _pass "watcher: reset waits for cooperative cancellation"
fi
_upterm_cancel_ttl_watcher "$ttl_token_a"

ttl_unrelated_dir=$(_upterm_ttl_control_dir "$ttl_token_a")
mkdir -m 700 "$ttl_unrelated_dir"
if [[ -x /usr/bin/setsid ]]; then
  /usr/bin/setsid sleep 300 &
else
  sleep 300 &
fi
ttl_unrelated_pid=$!
_track_test_pid "$ttl_unrelated_pid"
_upterm_write_pid_file \
  "$ttl_unrelated_dir/watcher" "$ttl_unrelated_pid" "$ttl_token_a"
_upterm_supervisor_write_status "$ttl_unrelated_dir/ready" "$ttl_token_a" ready
: >"$ttl_signal_audit"
# shellcheck disable=SC2329 # Production cancellation would invoke this audit double.
kill() {
  [[ "${1:-}" == -0 ]] || printf '%s\n' "$*" >>"$ttl_signal_audit"
  command kill "$@"
}
set +e
_upterm_cancel_ttl_watcher "$ttl_token_a" >/dev/null 2>&1
ttl_unrelated_rc=$?
set -e
unset -f kill
[[ -z "$saved_ttl_kill" ]] || eval "$saved_ttl_kill"
_assert_exit "watcher: unrelated command identity fails closed" 1 "$ttl_unrelated_rc"
if [[ ! -s "$ttl_signal_audit" ]] && command kill -0 "$ttl_unrelated_pid" 2>/dev/null; then
  _pass "watcher: stale PID or PGID state never signals an unrelated group"
else
  _fail "watcher: stale PID or PGID state affected an unrelated group"
fi
_assert_file_exists "watcher: unverifiable reused state is retained" \
  "$ttl_unrelated_dir/watcher"
command kill "$ttl_unrelated_pid" 2>/dev/null || true
wait "$ttl_unrelated_pid" 2>/dev/null || true
rm -rf "$ttl_unrelated_dir"

_upterm_start_ttl_watcher 60 "ds" "$ttl_token_a"
ttl_dead_pid=""
ttl_dead_identity=""
ttl_dead_token=""
_upterm_read_pid_file "$ttl_control_a/watcher" \
  ttl_dead_pid ttl_dead_identity ttl_dead_token
_assert_eq "watcher: death fixture state has the exact token" \
  "$ttl_token_a" "$ttl_dead_token"
command kill -KILL "$ttl_dead_pid" 2>/dev/null || true
wait "$ttl_dead_pid" 2>/dev/null || true
if _upterm_pid_matches_identity "$ttl_dead_pid" "$ttl_dead_identity"; then
  _fail "watcher: killed death fixture still has its recorded identity"
else
  _pass "watcher: killed death fixture no longer has its recorded identity"
fi
for ((ttl_attempt = 0; ttl_attempt < 500; ttl_attempt++)); do
  command kill -0 "$ttl_dead_pid" 2>/dev/null || break
  sleep 0.01
done
set +e
_upterm_cancel_ttl_watcher "$ttl_token_a" >/dev/null 2>&1
ttl_dead_rc=$?
set -e
_assert_exit "watcher: dead watcher without acknowledgement fails closed" 1 "$ttl_dead_rc"
_assert_file_exists "watcher: dead watcher state is retained" "$ttl_control_a/watcher"
rm -rf "$ttl_control_a"

mkdir -m 700 "$ttl_control_a"
printf 'malformed\n' >"$ttl_control_a/watcher"
set +e
_upterm_cancel_ttl_watcher "$ttl_token_a" >/dev/null 2>&1
ttl_malformed_rc=$?
set -e
_assert_exit "watcher: malformed state fails closed" 1 "$ttl_malformed_rc"
_assert_file_exists "watcher: malformed state is retained" "$ttl_control_a/watcher"
rm -rf "$ttl_control_a"

_upterm_start_ttl_watcher 60 "ds" "$ttl_token_a"
saved_ttl_write_state=$(declare -f _upterm_write_token_state)
_upterm_write_token_state() {
  [[ "$2" != request ]]
}
set +e
_upterm_cancel_ttl_watcher "$ttl_token_a" >/dev/null 2>&1
ttl_cancel_failure_rc=$?
set -e
eval "$saved_ttl_write_state"
_assert_exit "watcher: cancellation publication failure is reported" \
  1 "$ttl_cancel_failure_rc"
_assert_file_exists "watcher: cancellation failure retains exact state" \
  "$ttl_control_a/watcher"
_upterm_cancel_ttl_watcher "$ttl_token_a"

ttl_symlink_victim=$(_tmpdir)
printf 'victim\n' >"$ttl_symlink_victim/keep"
ln -s "$ttl_symlink_victim" "$ttl_control_a"
set +e
_upterm_start_ttl_watcher 60 "ds" "$ttl_token_a" >/dev/null 2>&1
ttl_symlink_rc=$?
set -e
_assert_exit "watcher: planted control symlink is rejected" 1 "$ttl_symlink_rc"
_assert_file_content "watcher: planted symlink target is untouched" \
  "victim" "$ttl_symlink_victim/keep"
rm -f "$ttl_control_a"

: >"$DS_UNSHARE_LOG"
_upterm_start_ttl_watcher 1 "myses" "$ttl_token_a"
for ((ttl_attempt = 0; ttl_attempt < 1000; ttl_attempt++)); do
  [[ -s "$DS_UNSHARE_LOG" ]] && break
  sleep 0.01
done
unshare_calls=$(<"$DS_UNSHARE_LOG")
_assert_contains "watcher: expiry carries its expected lifecycle token" \
  "expected=$ttl_token_a expiry=$ttl_token_a args=--unshare myses" "$unshare_calls"
for ((ttl_attempt = 0; ttl_attempt < 500; ttl_attempt++)); do
  [[ ! -e "$ttl_control_a" && ! -L "$ttl_control_a" ]] && break
  sleep 0.01
done
_assert_file_missing "watcher: natural expiry removes exact watcher state" \
  "$ttl_control_a"

ttl_guard_dir=$(_tmpdir)
ttl_guard_snapshot=$(_upterm_known_hosts_snapshot_file "$ttl_token_b")
printf 'guard\n' >"$ttl_guard_snapshot"
ttl_guard_pid=""
_upterm_current_pid ttl_guard_pid
_upterm_write_snapshot_owner create starting "$ttl_guard_pid" \
  "$ttl_token_b" "$ttl_guard_snapshot"
set +e
DS_UPTERM_EXPECTED_TOKEN="$ttl_token_a" \
  _upterm_share_stop_locked "newer" >"$ttl_guard_dir/output" 2>&1
ttl_guard_rc=$?
set -e
_assert_exit "watcher: old-token expiry cannot stop a newer lifecycle" 1 "$ttl_guard_rc"
_upterm_read_snapshot_owner "$(_upterm_known_hosts_owner_file)"
_assert_eq "watcher: newer lifecycle token remains owned" \
  "$ttl_token_b" "$_UPTERM_SNAPSHOT_TOKEN"
rm -f "$(_upterm_known_hosts_owner_file)" "$ttl_guard_snapshot"

# --- TTL=0 disables the watcher ---
DS_UPTERM_SHARE_TTL="0"
export MOCK_SESSIONS="ds"
DS_UPTERM_GITHUB_USER="testuser"
DS_SHARE_INFO_FILE="$(_default_share_info_file)"
DS_UPTERM_PID_FILE="$(_upterm_pid_file)"
SESSION="ds" HOST=""
result=$(_do_share 2>&1) || true
_assert_not_contains "ttl=0: no auto-expire message" "auto-expire" "$result"
# Clean up share state through the token-owning lifecycle path.
_share_stop "ds" >/dev/null 2>&1 || true

# --- TTL>0 creates watcher on successful share ---
# Note: _do_share must NOT be captured in $() because the mock upterm starts
# background jobs (the hosted_cmd loop) that would make the subshell hang.
# Use a temp file to capture output instead.
_share_out=$(_tmpdir)/share.out
DS_UPTERM_SHARE_TTL="3600"
DS_UPTERM_PRIVATE_KEY="$TEST_HOME/.ssh/test_upterm_key"
DS_UPTERM_KNOWN_HOSTS=""
DS_UPTERM_HOST=""
DS_UPTERM_AUTHORIZED_KEYS=""
DS_UPTERM_PUSH=""
export MOCK_SESSIONS="ds"
DS_UPTERM_GITHUB_USER="testuser"
DS_SHARE_INFO_FILE="$(_default_share_info_file)"
DS_UPTERM_PID_FILE="$(_upterm_pid_file)"
SESSION="ds" HOST=""
_do_share >"$_share_out" 2>&1 || true
result=$(cat "$_share_out")
_assert_contains "ttl>0: auto-expire message shown" "auto-expire" "$result"
_upterm_read_snapshot_owner "$(_upterm_known_hosts_owner_file)"
share_watcher_token="$_UPTERM_SNAPSHOT_TOKEN"
share_watcher_control=$(_upterm_ttl_control_dir "$share_watcher_token")
_assert_file_exists "ttl>0: token-scoped watcher created on share" \
  "$share_watcher_control/watcher"
share_watcher_pid=""
share_watcher_identity=""
share_watcher_state_token=""
_upterm_read_pid_file "$share_watcher_control/watcher" \
  share_watcher_pid share_watcher_identity share_watcher_state_token
_assert_eq "ttl>0: watcher state matches the active lifecycle token" \
  "$share_watcher_token" "$share_watcher_state_token"
if _upterm_ttl_watcher_matches \
  "$share_watcher_pid" "$share_watcher_identity" "$share_watcher_token"; then
  _pass "ttl>0: watcher state names the exact live watcher"
else
  _fail "ttl>0: watcher state does not name the exact live watcher"
fi

# --- _share_stop cancels the watcher ---
SESSION="ds" HOST=""
_do_unshare 2>&1 || true
_assert_file_missing "unshare: exact TTL watcher state removed" "$share_watcher_control"
if [[ "$share_watcher_pid" =~ ^[0-9]+$ ]] && kill -0 "$share_watcher_pid" 2>/dev/null; then
  _fail "unshare: watcher process killed"
else
  _pass "unshare: watcher process killed"
fi

# Reset sharing vars for remaining tmux tests
# shellcheck disable=SC2034  # sourced helpers read these globals dynamically.
DS_SHARE_VIA=""
# shellcheck disable=SC2034  # sourced helpers read these globals dynamically.
DS_NO_ATTACH=0
# shellcheck disable=SC2034  # sourced helpers read this global dynamically.
DS_SHARE_INFO_FILE=""
DS_UPTERM_PID_FILE=""
DS_UPTERM_GITHUB_USER=""
DS_UPTERM_AUTHORIZED_KEYS=""
DS_UPTERM_PUSH=""
DS_UPTERM_SHARE_TTL=""
SESSION=""
# shellcheck disable=SC2034  # sourced helpers read this global dynamically.
HOST=""

# ---------------------------------------------------------------------------
# Tests: Session naming
# ---------------------------------------------------------------------------

echo ""
echo "=== Session naming ==="

# Session name is derived from profile or profile-instance.
# Default (no session) → "ds" with ds profile.

_reset_tmux_log
export MOCK_SESSIONS=""
export MOCK_DS_MANAGED=""
unset MOCK_TMUX_WINDOWS MOCK_TMUX_LOCAL_PANE_BORDER_FORMAT MOCK_TMUX_LOCAL_PANE_BORDER_FORMAT_SET
SESSION="ds"
PROFILE="ds"
_do_session
log=$(_tmux_log)
_assert_contains "default → session 'ds'" "new-session -d -s ds" "$log"
_assert_contains "tags session with DS_MANAGED" "set-environment -t ds DS_MANAGED 1" "$log"
_assert_contains "new session publishes status marker by session ID" \
  "set-option -t \$1 @ds_status_labels_version $_DS_STATUS_LABELS_VERSION:\$1" "$log"
_assert_contains "display label includes host and session" \
  "set-option -t ds status-left [ $_DS_HOST_LABEL_FORMAT$_DS_HOST_LABEL_SEPARATOR#S ]" "$log"
_assert_contains "pane title hook keeps future windows host-free" \
  "set-hook -t ds $_DS_PANE_BORDER_HOOK set-window-option pane-border-format \" #{pane_current_command} \"" "$log"
_assert_contains "pane title repairs initial window" \
  "set-window-option -t %1 pane-border-format  #{pane_current_command}" "$log"
_assert_not_contains "display label does not rename session" "rename-session" "$log"

_reset_tmux_log
export MOCK_DS_MANAGED=""
SESSION="dev"
PROFILE="dev"
_do_session
log=$(_tmux_log)
_assert_contains "dev → session 'dev'" "new-session -d -s dev" "$log"

_reset_tmux_log
export MOCK_DS_MANAGED=""
SESSION="dev-work"
PROFILE="dev"
_do_session
log=$(_tmux_log)
_assert_contains "dev-work → session 'dev-work'" "new-session -d -s dev-work" "$log"

_reset_tmux_log
export MOCK_DS_MANAGED=""
SESSION="web-2"
PROFILE="web"
_do_session
log=$(_tmux_log)
_assert_contains "web-2 → session 'web-2'" "new-session -d -s web-2" "$log"

# Arbitrary name uses ds profile
_reset_tmux_log
export MOCK_DS_MANAGED=""
SESSION="myproject"
PROFILE="ds"
_do_session
log=$(_tmux_log)
_assert_contains "myproject → session 'myproject'" "new-session -d -s myproject" "$log"
_assert_contains "myproject tags with DS_MANAGED" "set-environment -t myproject DS_MANAGED 1" "$log"

_assert_eq "status-left fallback adds host to short session format" \
  "[ $_DS_HOST_LABEL_FORMAT$_DS_HOST_LABEL_SEPARATOR#S ] " "$(_status_left_with_host '[ #S ] ')"
_assert_eq "status-left fallback adds host to long session format" \
  "[ $_DS_HOST_LABEL_FORMAT$_DS_HOST_LABEL_SEPARATOR#{session_name} ] " \
  "$(_status_left_with_host '[ #{session_name} ] ')"
_assert_eq "status-left fallback keeps existing host format" \
  "[ #H #S ] " "$(_status_left_with_host '[ #H #S ] ')"
_assert_eq "status-left fallback keeps existing host_short format" \
  "[ #{host_short} #S ] " "$(_status_left_with_host '[ #{host_short} #S ] ')"
_assert_eq "status-left fallback keeps existing alias host format" \
  "[ #{?@hostname_alias,#{@hostname_alias},#{host_short}} #S ] " \
  "$(_status_left_with_host '[ #{?@hostname_alias,#{@hostname_alias},#{host_short}} #S ] ')"
_assert_eq "status-left fallback keeps styled host before session" \
  "#[fg=green]#H#[default] #S" \
  "$(_status_left_with_host '#[fg=green]#H#[default] #S')"
_assert_eq "status-left fallback keeps styled host/session separator" \
  "#H #[fg=cyan]#S" "$(_status_left_with_host '#H #[fg=cyan]#S')"
_assert_eq "status-left fallback preserves surrounding style" \
  "#[fg=blue][ $_DS_HOST_LABEL_FORMAT$_DS_HOST_LABEL_SEPARATOR#S ] #[default]" \
  "$(_status_left_with_host '#[fg=blue][ #S ] #[default]')"
_assert_eq "pane border drops hostname alias prefix" \
  " #{pane_current_command} " \
  "$(_pane_border_without_host ' #{?@hostname_alias,#{@hostname_alias},#{host_short}}  #{pane_current_command} ')"
_assert_eq "pane border preserves style while dropping host" \
  "#[fg=blue] #{pane_current_command} " \
  "$(_pane_border_without_host '#[fg=blue] #{?@hostname_alias,#{@hostname_alias},#{host_short}}  #{pane_current_command} ')"
_assert_eq "pane border keeps app-only format" \
  " #{pane_current_command} " "$(_pane_border_without_host ' #{pane_current_command} ')"
_assert_eq "tmux command quoting preserves spaces and quotes" \
  '" x \"y\" z "' "$(_tmux_command_quote ' x "y" z ')"

# ---------------------------------------------------------------------------
# Tests: Existing session attachment
# ---------------------------------------------------------------------------

echo ""
echo "=== Session attachment ==="

# tmux-resurrect preserves layouts but not ds's session-local environment.
# The integration rows travel inside the exact resurrect snapshot so metadata
# cannot drift away from the layout it describes.
_resurrect_file=$(_tmpdir)/resurrect.txt
printf 'pane\tds\t1\n' >"$_resurrect_file"
export MOCK_SESSIONS="ds native"
export MOCK_DS_MANAGED=" ds"
export MOCK_DS_SHELL_NAME="bash"
set +e
_do_resurrect_save "$_resurrect_file"
_resurrect_save_rc=$?
set -e
_assert_exit "resurrect metadata: save succeeds" 0 "$_resurrect_save_rc"
_assert_contains "resurrect metadata: appends managed session identity" \
  $'ds-v1\tds\tbash' "$(cat "$_resurrect_file")"
_assert_not_contains "resurrect metadata: omits native tmux sessions" \
  $'ds-v1\tnative\t' "$(cat "$_resurrect_file")"
_resurrect_mode=$(stat -c '%a' "$_resurrect_file" 2>/dev/null ||
  stat -f '%Lp' "$_resurrect_file" 2>/dev/null || true)
_assert_eq "resurrect metadata: protects snapshot contents" "600" "$_resurrect_mode"

export MOCK_DS_SHELL_UNSET=1
if _session_shell_name ds >/dev/null; then
  _fail "resurrect metadata: rejects tmux unset-environment sentinel"
else
  _pass "resurrect metadata: rejects tmux unset-environment sentinel"
fi
unset MOCK_DS_SHELL_UNSET

_resurrect_dash_dir=$(_tmpdir)
printf 'pane\tds\t1\n' >"$_resurrect_dash_dir/--reference=other"
(
  cd "$_resurrect_dash_dir"
  _do_resurrect_save '--reference=other'
)
_assert_contains "resurrect metadata: option-looking paths stay files" \
  $'ds-v1\tds\tbash' "$(cat "$_resurrect_dash_dir/--reference=other")"

_reset_tmux_log
printf 'pane\trestored-ds\t1\nds-v1\trestored-ds\tbash\n' >"$_resurrect_file"
export MOCK_SESSIONS="restored-ds"
export MOCK_DS_MANAGED=""
set +e
_do_resurrect_restore "$_resurrect_file"
_resurrect_restore_rc=$?
set -e
_assert_exit "resurrect metadata: restore succeeds" 0 "$_resurrect_restore_rc"
_resurrect_restore_log=$(_tmux_log)
_assert_contains "resurrect metadata: restores ds ownership" \
  "tmux set-environment -t restored-ds DS_MANAGED 1" \
  "$_resurrect_restore_log"
_assert_contains "resurrect metadata: restores selected shell" \
  "tmux set-environment -t restored-ds DS_SHELL_NAME bash" \
  "$_resurrect_restore_log"
_assert_contains "resurrect metadata: restores login-shell default" \
  "tmux set-option -t restored-ds default-command exec $(command -v bash) -l" \
  "$_resurrect_restore_log"
_assert_contains "resurrect metadata: marks this server restore complete" \
  "tmux set-option -g @ds_resurrect_restored_at 1234567890" \
  "$_resurrect_restore_log"
_reset_tmux_log
_do_resurrect_begin
_assert_contains "resurrect metadata: marks this server restore in progress" \
  "tmux set-option -g @ds_resurrect_restoring_at 1234567890" "$(_tmux_log)"

_resurrect_wait_dir=$(_tmpdir)
_resurrect_wait_marker=$(_tmpdir)/marker
touch "$_resurrect_wait_dir/last"
export MOCK_CONTINUUM_RESTORE=on
export MOCK_RESURRECT_DIR="$_resurrect_wait_dir"
export MOCK_RESURRECT_MARKER_FILE="$_resurrect_wait_marker"
if _resurrect_restore_expected; then
  _pass "resurrect wait: detects a pending saved environment"
else
  _fail "resurrect wait: detects a pending saved environment"
fi
export MOCK_CONTINUUM_RESTORE=off
export MOCK_DS_AUTO_RESTORE=on
if _resurrect_restore_expected; then
  _pass "resurrect wait: accepts default-server restore ownership"
else
  _fail "resurrect wait: accepts default-server restore ownership"
fi
touch "$HOME/tmux_no_auto_restore"
if _resurrect_restore_expected; then
  _fail "resurrect wait: default ownership still honors the halt file"
else
  _pass "resurrect wait: default ownership still honors the halt file"
fi
rm "$HOME/tmux_no_auto_restore" "$_resurrect_wait_dir/last"
if _resurrect_restore_expected; then
