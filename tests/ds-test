#!/usr/bin/env bash
# Older ShellCheck releases misclassify test helpers invoked by name.
# shellcheck disable=SC2317
# ds-test — unit tests for the ds dev-session launcher.
#
# Creates temp directories to simulate $HOME and tests internal functions
# in isolation. Mocks tmux to avoid real session management.
#
# Usage: ds-test

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REAL_ZSH=$(command -v zsh || true)
REAL_SSH_KEYGEN=$(command -v ssh-keygen || true)

# shellcheck source=test-helpers.sh
. "$SCRIPT_DIR/test-helpers.sh"

# ---------------------------------------------------------------------------
# Setup: override HOME, source ds for internal functions
# ---------------------------------------------------------------------------

TEST_HOME=$(_tmpdir)
export HOME="$TEST_HOME"
unset XDG_CONFIG_HOME
unset XDG_STATE_HOME
export CONF_DIR="$TEST_HOME/.config/ds"
mkdir -p "$CONF_DIR"

# Create a minimal profile for testing
cat >"$CONF_DIR/profile-dev.sh" <<'PROFILE'
_profile_dev() {
    local session="$1"
    : # no-op for testing
}
PROFILE

cat >"$CONF_DIR/profile-web.sh" <<'PROFILE'
_profile_web() {
    local session="$1"
    : # no-op for testing
}
PROFILE

export DS_SOURCED=1
export DS_UPTERM_PRIVATE_KEY="$TEST_HOME/.ssh/test_upterm_key"
mkdir -p "$TEST_HOME/.ssh"
printf 'dummy' >"$DS_UPTERM_PRIVATE_KEY"
# shellcheck source=../bin/ds
. "$SCRIPT_DIR/../bin/ds"
_epoch_seconds() {
  printf '%s\n' "${MOCK_NOW:-1234567890}"
}
# Install and load the upterm share backend for sharing tests
cp "$SCRIPT_DIR/../lib/plugins/share-upterm.sh" "$CONF_DIR/"
# shellcheck source=/dev/null
. "$CONF_DIR/share-upterm.sh"

# Create a mock tmux in a temp bin dir and prepend to PATH
MOCK_BIN=$(_tmpdir)
TMUX_LOG="$MOCK_BIN/tmux.log"

cat >"$MOCK_BIN/tmux" <<'MOCK'
#!/usr/bin/env bash
# Mock tmux that logs calls and simulates responses
echo "tmux $*" >> "${TMUX_LOG:-/dev/null}"
args=("$@")
if [[ -n "${MOCK_TMUX_SERVER_FILE:-}" &&
    ! -f "$MOCK_TMUX_SERVER_FILE" && "${args[0]:-}" != "new-session" ]]; then
    exit 1
fi
case "${args[0]:-}" in
    has-session)
        # Check MOCK_SESSIONS for existence
        session="${args[2]#=}"  # strip = prefix
        if [[ " ${MOCK_SESSIONS:-} " == *" $session "* ]]; then
            exit 0
        else
            exit 1
        fi
        ;;
    list-sessions)
        for _arg in "${args[@]}"; do
            if [[ "$_arg" == '#{session_name}' ]]; then
                for _session_name in ${MOCK_SESSIONS:-}; do
                    printf '%s\n' "$_session_name"
                done
                exit 0
            fi
        done
        if [[ -n "${MOCK_TMUX_SESSION_ROWS+x}" ]]; then
            printf '%s\n' "$MOCK_TMUX_SESSION_ROWS"
            exit 0
        fi
        _session_id="${MOCK_TMUX_SESSION_ID:-}"
        [[ -n "$_session_id" ]] || _session_id='$1'
        _status_marker="${MOCK_DS_STATUS_LABELS_MARKER:-}"
        if [[ -n "${MOCK_DS_STATUS_LABELS_STATE_FILE:-}" &&
            -f "$MOCK_DS_STATUS_LABELS_STATE_FILE" ]]; then
            _status_marker=$(<"$MOCK_DS_STATUS_LABELS_STATE_FILE")
        fi
        for _session_name in ${MOCK_SESSIONS:-}; do
            printf '%s\t%s\t%s\n' "$_session_name" "$_session_id" \
                "$_status_marker"
        done
        exit 0
        ;;
    ls)
        # Render the requested -F format per session so callers that ask for
        # combined fields (e.g. `_do_list`) get real name<TAB>info lines, while a
        # bare `#{session_name}` format still yields plain names.
        _ls_fmt=""
        for ((_i = 0; _i < ${#args[@]}; _i++)); do
            [[ "${args[_i]}" == "-F" ]] && _ls_fmt="${args[_i + 1]:-}"
        done
        if [[ -z "$_ls_fmt" ]]; then
            echo "${MOCK_TMUX_LS:-}" | grep -v '^$' || true
        else
            while IFS= read -r _s; do
                [[ -n "$_s" ]] || continue
                _line="$_ls_fmt"
                _line="${_line//'#{session_name}'/$_s}"
                _line="${_line//'#{session_windows}'/3}"
                _line="${_line//'#{?session_attached,attached,detached}'/detached}"
                echo "$_line"
            done < <(echo "${MOCK_TMUX_LS:-}" | grep -v '^$')
        fi
        ;;
    set-environment)
        # Track DS_MANAGED sessions: set-environment -t <session> DS_MANAGED 1
        if [[ "${args[3]:-}" == "DS_MANAGED" ]]; then
            export MOCK_DS_MANAGED="${MOCK_DS_MANAGED:-} ${args[2]}"
        fi
        exit 0
        ;;
    show-environment)
        # show-environment -t =<session> DS_MANAGED|DS_SHELL_NAME
        _se_name="${args[2]#=}"
        if [[ "${args[3]:-}" == "DS_SHELL_NAME" &&
            " ${MOCK_DS_MANAGED:-} " == *" $_se_name "* ]]; then
            if [[ "${MOCK_DS_SHELL_UNSET:-0}" == "1" ]]; then
                echo "-DS_SHELL_NAME"
                exit 0
            fi
            echo "DS_SHELL_NAME=${MOCK_DS_SHELL_NAME:-bash}"
            exit 0
        fi
        if [[ " ${MOCK_DS_MANAGED:-} " == *" $_se_name "* ]]; then
            echo "DS_MANAGED=1"
            exit 0
        else
            exit 1
        fi
        ;;
    display-message)
        # Support session name query and info format
        for _a in "${args[@]}"; do
            if [[ "$_a" == *'#{start_time}'* ]]; then
                echo "${MOCK_TMUX_START_TIME:-1234567890}"
                exit 0
            fi
            if [[ "$_a" == *'#{session_id}'* ]]; then
                echo "${MOCK_TMUX_SESSION_ID:-\$1}"
                exit 0
            fi
            if [[ "$_a" == *'#{session_name}'* ]]; then
                echo "${MOCK_CURRENT_SESSION:-ds}"
                exit 0
            fi
        done
        echo "1 windows (detached)"
        exit 0
        ;;
    list-windows)
        while IFS= read -r _w; do
            [[ -n "$_w" ]] || continue
            echo "$_w"
        done <<<"${MOCK_TMUX_WINDOWS:-%1}"
        exit 0
        ;;
    show-window-options)
        if [[ " ${args[*]} " == *" pane-border-format"* ]]; then
            if [[ " ${args[*]} " == *" -v"* ]]; then
                echo "${MOCK_TMUX_LOCAL_PANE_BORDER_FORMAT:-}"
            elif [[ "${MOCK_TMUX_LOCAL_PANE_BORDER_FORMAT_SET:-0}" == "1" || -n "${MOCK_TMUX_LOCAL_PANE_BORDER_FORMAT:-}" ]]; then
                echo "pane-border-format '${MOCK_TMUX_LOCAL_PANE_BORDER_FORMAT:-}'"
            else
                :
            fi
            exit 0
        fi
        if [[ " ${args[*]} " != *" -q "* ]]; then
            exit 1
        fi
        exit 0
        ;;
    show-options)
        if [[ " ${args[*]} " == *" @ds-resurrect-auto-restore"* ]]; then
            echo "${MOCK_DS_AUTO_RESTORE:-}"
            exit 0
        fi
        if [[ " ${args[*]} " == *" @continuum-restore-max-delay"* ]]; then
            echo "${MOCK_CONTINUUM_RESTORE_MAX_DELAY:-}"
            exit 0
        fi
        if [[ " ${args[*]} " == *" @continuum-restore"* ]]; then
            echo "${MOCK_CONTINUUM_RESTORE:-}"
            exit 0
        fi
        if [[ " ${args[*]} " == *" @resurrect-dir"* ]]; then
            echo "${MOCK_RESURRECT_DIR:-}"
            exit 0
        fi
        if [[ " ${args[*]} " == *" @ds_resurrect_restored_at"* ]]; then
            if [[ -n "${MOCK_RESURRECT_MARKER_FILE:-}" &&
                -f "$MOCK_RESURRECT_MARKER_FILE" ]]; then
                cat "$MOCK_RESURRECT_MARKER_FILE"
            fi
            exit 0
        fi
        if [[ " ${args[*]} " == *" @ds_resurrect_restoring_at"* ]]; then
            if [[ -n "${MOCK_RESURRECT_BEGIN_FILE:-}" &&
                -f "$MOCK_RESURRECT_BEGIN_FILE" ]]; then
                cat "$MOCK_RESURRECT_BEGIN_FILE"
            fi
            exit 0
        fi
        if [[ " ${args[*]} " == *" status-left"* ]]; then
            if [[ " ${args[*]} " == *" -g"* ]]; then
                echo "${MOCK_TMUX_STATUS_LEFT:-[ #S ] }"
            elif [[ " ${args[*]} " == *" -v"* ]]; then
                echo "${MOCK_TMUX_LOCAL_STATUS_LEFT:-}"
            elif [[ "${MOCK_TMUX_LOCAL_STATUS_LEFT_SET:-0}" == "1" || -n "${MOCK_TMUX_LOCAL_STATUS_LEFT:-}" ]]; then
                echo "status-left '${MOCK_TMUX_LOCAL_STATUS_LEFT:-}'"
            else
                :
            fi
            exit 0
        fi
        if [[ " ${args[*]} " == *" pane-border-format"* ]]; then
            if [[ " ${args[*]} " == *" -g"* ]]; then
                _default_pane_border=' #{?@hostname_alias,#{@hostname_alias},#{host_short}}  #{pane_current_command} '
                echo "${MOCK_TMUX_PANE_BORDER_FORMAT:-$_default_pane_border}"
            elif [[ " ${args[*]} " == *" -v"* ]]; then
                echo "${MOCK_TMUX_LOCAL_PANE_BORDER_FORMAT:-}"
            elif [[ "${MOCK_TMUX_LOCAL_PANE_BORDER_FORMAT_SET:-0}" == "1" || -n "${MOCK_TMUX_LOCAL_PANE_BORDER_FORMAT:-}" ]]; then
                echo "pane-border-format '${MOCK_TMUX_LOCAL_PANE_BORDER_FORMAT:-}'"
            else
                :
            fi
            exit 0
        fi
        exit 0
        ;;
    set-hook)
        [[ "${MOCK_TMUX_FAIL_SET_HOOK:-0}" == "1" ]] && exit 7
        exit 0
        ;;
    set-option)
        if [[ "${args[3]:-}" == "@ds_status_labels_version" &&
            -n "${MOCK_DS_STATUS_LABELS_STATE_FILE:-}" ]]; then
            [[ "${args[2]:-}" == "${MOCK_TMUX_SESSION_ID:-}" ]] || exit 1
            printf '%s\n' "${args[4]:-}" >"$MOCK_DS_STATUS_LABELS_STATE_FILE"
        fi
        exit 0
        ;;
    new-session)
        if [[ -n "${MOCK_TMUX_SERVER_FILE:-}" ]]; then
            : >"$MOCK_TMUX_SERVER_FILE"
        fi
        if [[ " ${args[*]} " == *" -P "* ]]; then
            printf '%s\n' "${MOCK_TMUX_NEW_SESSION_ID:-\$1}"
        fi
        exit 0
        ;;
    attach|switch-client|kill-session|rename-window|split-window|new-window|select-window|send-keys|set-window-option)
        exit 0
        ;;
esac
MOCK
chmod +x "$MOCK_BIN/tmux"

cat >"$MOCK_BIN/upterm" <<'MOCK'
#!/usr/bin/env bash
echo "upterm $*" >> "${TMUX_LOG:-/dev/null}"
if [[ "${MOCK_UPTERM_FAIL:-}" == 1 ]]; then
  exit 7
fi
if [[ "$1" == "host" ]]; then
  if [[ -n "${MOCK_UPTERM_PID_FILE:-}" ]]; then
    printf '%s\n' "$$" >"$MOCK_UPTERM_PID_FILE"
  fi
  if [[ "${MOCK_UPTERM_IGNORE_TERM:-}" == 1 ]]; then
    trap '[[ -z "${MOCK_UPTERM_TERM_FILE:-}" ]] || printf "term\n" >"$MOCK_UPTERM_TERM_FILE"' TERM
  fi
  known_hosts_file=""
  previous=""
  for arg; do
    if [[ "$previous" == "--known-hosts" ]]; then
      known_hosts_file="$arg"
      break
    fi
    previous="$arg"
  done
  if [[ -n "${MOCK_UPTERM_KNOWN_HOSTS_CAPTURE:-}" && -n "$known_hosts_file" ]]; then
    cat "$known_hosts_file" >"$MOCK_UPTERM_KNOWN_HOSTS_CAPTURE"
    printf 'upterm-known-hosts-path=%s\n' "$known_hosts_file" >>"${TMUX_LOG:-/dev/null}"
  fi
  # Execute the hosted command (bash -c "...") that writes the admin socket file.
  # Find args after "--" and run them so _share_start's admin socket polling works.
  found_dashdash=0
  hosted_args=()
  for arg; do
    if [[ "$found_dashdash" -eq 1 ]]; then
      hosted_args+=("$arg")
    elif [[ "$arg" == "--" ]]; then
      found_dashdash=1
    fi
  done
  if [[ ${#hosted_args[@]} -gt 0 ]]; then
    # Run hosted command in background (it sleeps forever, so we'll kill it on exit)
    export UPTERM_ADMIN_SOCKET="/tmp/mock-upterm-admin.sock"
    "${hosted_args[@]}" &
    hosted_pid=$!
    _mock_upterm_record_pid() {
      local recorded_pid="$1" weekday month day clock year extra temporary
      # Exercise a child exiting between the ps snapshot and identity capture.
      if [[ "$recorded_pid" != "$hosted_pid" &&
        -n "${MOCK_UPTERM_CHILD_RECORD_RACE_FILE:-}" &&
        ! -e "$MOCK_UPTERM_CHILD_RECORD_RACE_FILE" ]]; then
        : >"$MOCK_UPTERM_CHILD_RECORD_RACE_FILE"
        return 1
      fi
      if [[ -n "${DS_TEST_PID_LEDGER:-}" && -d "$DS_TEST_PID_LEDGER" &&
        ! -L "$DS_TEST_PID_LEDGER" ]]; then
        read -r weekday month day clock year extra \
          < <(LC_ALL=C ps -o lstart= -p "$recorded_pid")
        [[ -n "$weekday" && -n "$month" && -n "$day" &&
          -n "$clock" && -n "$year" && -z "${extra:-}" ]] || return 1
        temporary="$DS_TEST_PID_LEDGER/$recorded_pid.new.$$.$RANDOM"
        if ! (
          set -o noclobber
          printf '%s %s %s %s %s\n' \
            "$weekday" "$month" "$day" "$clock" "$year" \
            >"$temporary"
        ) 2>/dev/null || ! chmod 600 "$temporary" ||
          ! mv -f "$temporary" "$DS_TEST_PID_LEDGER/$recorded_pid"; then
          rm -f "$temporary"
          return 1
        fi
      fi
    }
    _mock_upterm_record_pid "$hosted_pid"
    hosted_child=""
    hosted_deadline=$((SECONDS + 10))
    while ((SECONDS < hosted_deadline)); do
      # Hosted setup runs short-lived commands before its persistent sleep.
      # A stale child snapshot is retryable; the deadline still fails closed.
      while read -r child parent; do
        [[ "$child" =~ ^[0-9]+$ && "$parent" == "$hosted_pid" ]] || continue
        if _mock_upterm_record_pid "$child"; then
          hosted_child="$child"
          break
        fi
      done < <(ps -axo pid=,ppid=)
      [[ -z "$hosted_child" ]] || break
      sleep 0.01
    done
    if [[ -z "$hosted_child" ]]; then
      kill -KILL "$hosted_pid" 2>/dev/null || true
      wait "$hosted_pid" 2>/dev/null || true
      exit 1
    fi
    if [[ -n "${MOCK_UPTERM_HOSTED_PID_FILE:-}" ]]; then
      printf '%s\n' "$hosted_pid" >"$MOCK_UPTERM_HOSTED_PID_FILE"
    fi
    _mock_upterm_cleanup_hosted() {
      local child parent
      local -a hosted_children=()
      while read -r child parent; do
        [[ "$child" =~ ^[0-9]+$ && "$parent" == "$hosted_pid" ]] || continue
        hosted_children+=("$child")
      done < <(ps -axo pid=,ppid=)
      kill -KILL "$hosted_pid" 2>/dev/null || true
      for child in "${hosted_children[@]+"${hosted_children[@]}"}"; do
        kill -KILL "$child" 2>/dev/null || true
      done
      wait "$hosted_pid" 2>/dev/null || true
    }
    trap _mock_upterm_cleanup_hosted EXIT
  fi
  # Write share info to stdout (goes to log file)
  printf '%s\n' "ssh session: ssh test@upterm.example"
  if [[ -n "${MOCK_UPTERM_EXIT_FILE:-}" ]]; then
    while [[ ! -e "$MOCK_UPTERM_EXIT_FILE" ]]; do
      sleep 0.01
    done
  else
    # Keep background process alive briefly if launched with & so kill -0 works.
    if [[ "${MOCK_UPTERM_IGNORE_TERM:-}" == 1 ]]; then
      mock_upterm_deadline=$((SECONDS + ${MOCK_UPTERM_SLEEP:-5}))
      while ((SECONDS < mock_upterm_deadline)); do
        sleep 1
      done
    else
      sleep "${MOCK_UPTERM_SLEEP:-5}"
    fi
  fi
  exit 0
fi
if [[ "$1" == "session" && "$2" == "current" ]]; then
  printf '%s\n' "ssh session: ssh test@upterm.example"
  exit 0
fi
exit 0
MOCK
chmod +x "$MOCK_BIN/upterm"

cat >"$MOCK_BIN/zsh" <<'MOCK'
#!/usr/bin/env bash
exit 0
MOCK
chmod +x "$MOCK_BIN/zsh"

export PATH="$MOCK_BIN:$PATH"
export TMUX_LOG

_reset_tmux_log() {
  : >"$TMUX_LOG"
}

_tmux_log() {
  cat "$TMUX_LOG" 2>/dev/null || true
}

set +e
(
  CLEANUP_PIDS=()
  CLEANUP_PID_IDENTITIES=()
  reuse_identity="Mon Jan 1 00:00:00 2026"
  # shellcheck disable=SC2329 # The cleanup tracker invokes this test double.
  _test_pid_identity() {
    # shellcheck disable=SC2034 # Branches assign the caller's dynamic local.
    case "$2" in
      _ttp_identity) _ttp_identity="$reuse_identity" ;;
      current) current="$reuse_identity" ;;
      *) return 1 ;;
    esac
  }
  _track_test_pid 4242 || exit 1
  reuse_identity="Tue Jan 2 00:00:00 2026"
  _track_test_pid 4242 || exit 1
  [[ "${#CLEANUP_PIDS[@]}" -eq 1 &&
    "${CLEANUP_PID_IDENTITIES[0]}" == "$reuse_identity" ]] || exit 1
  reuse_identity="Wed Jan 3 00:00:00 2026"
  printf '%s\n' "$reuse_identity" >"$TEST_PID_LEDGER/4242"
  chmod 600 "$TEST_PID_LEDGER/4242"
  _ingest_test_pid_ledger
  [[ "${CLEANUP_PID_IDENTITIES[0]}" == "$reuse_identity" ]] || exit 1
  printf 'Mon Jan 1 00:00:00 2026\n' >"$TEST_PID_LEDGER/4242"
  reuse_identity="Thu Jan 4 00:00:00 2026"
  _track_test_pid 4242 || exit 1
  _ingest_test_pid_ledger
  reuse_status=1
  [[ "${#CLEANUP_PIDS[@]}" -eq 1 &&
    "${CLEANUP_PID_IDENTITIES[0]}" == "$reuse_identity" ]] && reuse_status=0
  rm -f "$TEST_PID_LEDGER/4242"
  exit "$reuse_status"
)
cleanup_reuse_rc=$?
set -e
_assert_exit "test cleanup: PID reuse replaces stale tracked lifetimes" \
  0 "$cleanup_reuse_rc"

# Prove invocation cleanup can terminate a tracked nested background tree
# without signaling the process group shared with the test runner.
cleanup_tree_dir=$(_tmpdir)
cleanup_tree_child_file="$cleanup_tree_dir/child"
bash -c 'sleep 300 & printf "%s\n" "$!" >"$1"; wait' \
  bash "$cleanup_tree_child_file" &
cleanup_tree_root=$!
_track_test_pid "$cleanup_tree_root"
for ((cleanup_tree_attempt = 0; cleanup_tree_attempt < 500; cleanup_tree_attempt++)); do
  [[ -s "$cleanup_tree_child_file" ]] && break
  sleep 0.01
done
cleanup_tree_child=$(<"$cleanup_tree_child_file")
cleanup_tree_child_identity=""
_test_pid_identity "$cleanup_tree_child" cleanup_tree_child_identity
_terminate_test_tree "$cleanup_tree_root" TERM
wait "$cleanup_tree_root" 2>/dev/null || true
if _wait_for_test_pid_exit "$cleanup_tree_child" "$cleanup_tree_child_identity"; then
  _pass "test cleanup: tracked nested child is terminated"
else
  _fail "test cleanup: tracked nested child is terminated"
fi

cleanup_order_dir=$(_tmpdir)
cleanup_order_child_file="$cleanup_order_dir/child"
cleanup_order_parent_file="$cleanup_order_dir/parent"
cleanup_order_log="$cleanup_order_dir/signals"
bash -c '
  set -euo pipefail
  . "$1"
  bash -c '\''
    trap "exit 0" TERM
    sleep 300 &
    printf "%s\n" "$!" >"$1"
    while :; do sleep 1; done
  '\'' bash "$2" &
  parent=$!
  printf "%s\n" "$parent" >"$3"
  for ((attempt = 0; attempt < 500; attempt++)); do
    [[ -s "$2" ]] && break
    sleep 0.01
  done
  child=$(<"$2")
  signal_log=$4
  _track_test_pid "$child"
  _track_test_pid "$parent"
  kill() {
    printf "%s %s\n" "$1" "$2" >>"$signal_log"
    builtin kill "$@"
  }
  _cleanup_test_pids
' bash "$SCRIPT_DIR/test-helpers.sh" "$cleanup_order_child_file" \
  "$cleanup_order_parent_file" "$cleanup_order_log"
cleanup_order_first_term=$(awk '$1 == "-TERM" { print $2; exit }' "$cleanup_order_log")
_assert_file_content "test cleanup: child-first registration still signals parent first" \
  "$cleanup_order_first_term" "$cleanup_order_parent_file"

cleanup_identity_dir=$(_tmpdir)
cleanup_identity_trigger_file="$cleanup_identity_dir/trigger"
cleanup_identity_victim_file="$cleanup_identity_dir/victim"
cleanup_identity_log="$cleanup_identity_dir/signals"
bash -c '
  set -euo pipefail
  . "$1"
  bash -c '\''sleep 300 </dev/null >/dev/null 2>&1 & printf "%s\n" "$!" >"$1"'\'' \
    bash "$2"
  bash -c '\''sleep 300 </dev/null >/dev/null 2>&1 & printf "%s\n" "$!" >"$1"'\'' \
    bash "$3"
  trigger=$(<"$2")
  victim=$(<"$3")
  cleanup_identity_probe() {
    local rc=$?
    builtin kill -KILL "${trigger:-}" "${victim:-}" 2>/dev/null || true
    _cleanup || true
    return "$rc"
  }
  trap cleanup_identity_probe EXIT
  signal_log=$4
  marker="$signal_log.identity-changed"
  _track_test_pid "$trigger"
  _track_test_pid "$victim"
  _test_pid_still_live() {
    local pid="$1" expected="$2" status
    [[ "$pid" == "$victim" && -e "$marker" ]] && return 1
    _test_pid_still_owned "$pid" "$expected" || return 1
    status=$(LC_ALL=C command ps -o stat= -p "$pid" 2>/dev/null) || return 1
    [[ "$status" != *Z* ]]
  }
  kill() {
    printf "%s %s\n" "$1" "$2" >>"$signal_log"
    [[ "$2" != "$trigger" || "$1" != -TERM ]] || : >"$marker"
    builtin kill "$@"
  }
  _cleanup_test_pids
  builtin kill -KILL "$victim" 2>/dev/null || true
  trigger=""
  victim=""
' bash "$SCRIPT_DIR/test-helpers.sh" "$cleanup_identity_trigger_file" \
  "$cleanup_identity_victim_file" "$cleanup_identity_log"
cleanup_identity_victim=$(<"$cleanup_identity_victim_file")
if awk -v victim="$cleanup_identity_victim" '$2 == victim { found = 1 } END { exit !found }' \
  "$cleanup_identity_log"; then
  _fail "test cleanup: signal boundaries revalidate exact PID identity"
else
  _pass "test cleanup: signal boundaries revalidate exact PID identity"
fi

cleanup_exit_dir=$(_tmpdir)
cleanup_exit_child_file="$cleanup_exit_dir/child"
cleanup_exit_identity_file="$cleanup_exit_dir/identity"
bash -c '
  set -euo pipefail
  . "$1"
  bash -c '\''sleep 300 & printf "%s\n" "$!" >"$1"; wait'\'' \
    bash "$2" &
  root=$!
  _track_test_pid "$root"
  for ((attempt = 0; attempt < 500; attempt++)); do
    [[ -s "$2" ]] && break
    sleep 0.01
  done
  child=$(<"$2")
  identity=""
  _test_pid_identity "$child" identity
  printf "%s\n" "$identity" >"$3"
' bash "$SCRIPT_DIR/test-helpers.sh" "$cleanup_exit_child_file" \
  "$cleanup_exit_identity_file" &
cleanup_exit_probe=$!
_track_test_pid "$cleanup_exit_probe"
cleanup_exit_deadline=$((SECONDS + 20))
while ((SECONDS < cleanup_exit_deadline)); do
  kill -0 "$cleanup_exit_probe" 2>/dev/null || break
  sleep 0.01
done
if kill -0 "$cleanup_exit_probe" 2>/dev/null; then
  _fail "test cleanup: EXIT cleanup completes under a bounded condition"
  _terminate_test_tree "$cleanup_exit_probe" KILL
else
  _pass "test cleanup: EXIT cleanup completes under a bounded condition"
fi
