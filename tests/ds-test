    _upterm_acquire_snapshot_owner stale_snapshot_token lifecycle_snapshot
    printf 'stale\n' >"$lifecycle_snapshot"
    sleep 30 &
    stale_active_pid=$!
    _track_test_pid "$stale_active_pid"
    _upterm_write_snapshot_owner replace active "$stale_active_pid" \
      "$stale_snapshot_token" "$lifecycle_snapshot"
    kill "$stale_active_pid" 2>/dev/null || true
    wait "$stale_active_pid" 2>/dev/null || true
    stale_control=$(_upterm_control_dir "$stale_snapshot_token")
    _upterm_create_control_dir "$stale_snapshot_token"
    _upterm_supervisor_write_status \
      "$stale_control/done" "$stale_snapshot_token" exited
    block_snapshot_rm=1
    _reset_tmux_log
    set +e
    output=$(_share_start "cleanup-replacement" 2>&1)
    rc=$?
