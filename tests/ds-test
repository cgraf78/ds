    cleanup_stop_saved_info="$DS_SHARE_INFO_FILE"
    cleanup_stop_saved_snapshot_base="$lifecycle_snapshot_base"
    cleanup_stop_saved_snapshot_owner="$lifecycle_snapshot_owner"
    cleanup_stop_saved_snapshot="$lifecycle_snapshot"
