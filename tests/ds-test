    set +e
    cleanup_stop_start_output=$(_share_start "cleanup-stop" 2>&1)
    cleanup_stop_start_rc=$?
    set -e
    if ((cleanup_stop_start_rc == 0)); then
      _pass "host key: stop cleanup fixture starts"
    else
      _fail "host key: stop cleanup fixture starts: $cleanup_stop_start_output"
    fi
    block_snapshot_rm=1
    set +e
    output=$(_share_stop "cleanup-stop" 2>&1)
    rc=$?
    set -e
    _assert_exit "host key: stop cleanup failure propagates" 1 "$rc"
    _assert_contains "host key: stop cleanup failure is actionable" \
      "failed to remove the owned Upterm trust snapshot" "$output"
    _assert_file_exists "host key: stop cleanup failure preserves ownership" \
      "$lifecycle_snapshot_owner"
    block_snapshot_rm=0
    if _upterm_read_snapshot_owner "$lifecycle_snapshot_owner"; then
      _upterm_cleanup_known_hosts_snapshot \
        "$_UPTERM_SNAPSHOT_TOKEN" \
        "$(dirname "$lifecycle_snapshot_owner")/$_UPTERM_SNAPSHOT_BASENAME"
    fi
    DS_STATE_DIR="$cleanup_stop_saved_state_dir"
    DS_UPTERM_PID_FILE="$cleanup_stop_saved_pid"
    DS_SHARE_INFO_FILE="$cleanup_stop_saved_info"
    lifecycle_snapshot_base="$cleanup_stop_saved_snapshot_base"
    lifecycle_snapshot_owner="$cleanup_stop_saved_snapshot_owner"
    lifecycle_snapshot="$cleanup_stop_saved_snapshot"
    unset -f rm

    unset -f ssh-keyscan
    rm -f "$lifecycle_pid" "$lifecycle_info" "$(_upterm_session_file)" \
      "$(_upterm_admin_file)" "$(_upterm_log_file)"
  fi

  if [[ -n "$REAL_SSH_KEYGEN" ]]; then
    invalid_authorities=('foo[bar]:22' '[not:ipv6]:22')
    invalid_lookups=('foo[bar]' 'not:ipv6')
    for ((invalid_index = 0; invalid_index < ${#invalid_authorities[@]}; invalid_index++)); do
      invalid_known_hosts="$lifecycle_dir/invalid-$invalid_index-known-hosts"
      printf '@cert-authority %s %s\n' \
        "${invalid_lookups[$invalid_index]}" "$real_ca_key" >"$invalid_known_hosts"
      DS_UPTERM_HOST="${invalid_authorities[$invalid_index]}"
      DS_UPTERM_KNOWN_HOSTS="$invalid_known_hosts"
      rm -f "$lifecycle_pid" "$lifecycle_info" "$(_upterm_session_file)" \
        "$(_upterm_admin_file)" "$(_upterm_log_file)"
      _reset_tmux_log
      set +e
      output=$(_share_start "invalid-authority" 2>&1)
      rc=$?
      set -e
      _assert_exit "host key: invalid authority fails before CA delegation" 1 "$rc"
      _assert_contains "host key: invalid authority reports parser rejection" \
        "invalid upterm server address" "$output"
      _assert_not_contains "host key: invalid authority never invokes Upterm" \
        "upterm host" "$(_tmux_log)"
      _assert_file_missing "host key: invalid authority creates no pid file" "$lifecycle_pid"
      _assert_file_missing "host key: invalid authority creates no session file" \
        "$(_upterm_session_file)"
      _assert_file_missing "host key: invalid authority creates no admin file" \
        "$(_upterm_admin_file)"
      _assert_file_missing "host key: invalid authority creates no log file" \
        "$(_upterm_log_file)"
      _assert_file_missing "host key: invalid authority creates no share info" "$lifecycle_info"

      if [[ -f "$lifecycle_pid" ]]; then
        invalid_pid=$(cat "$lifecycle_pid" 2>/dev/null || true)
        if [[ "$invalid_pid" =~ ^[0-9]+$ ]]; then
          # shellcheck disable=SC2218 # A later audit double must not shadow cleanup.
          command kill "$invalid_pid" 2>/dev/null || true
        fi
      fi
      rm -f "$lifecycle_pid" "$lifecycle_info" "$(_upterm_session_file)" \
        "$(_upterm_admin_file)" "$(_upterm_log_file)"
    done
  fi
  DS_UPTERM_HOST=""
  DS_UPTERM_KNOWN_HOSTS=""
  DS_UPTERM_PID_FILE=""
fi

