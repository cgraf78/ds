    set -e
    unset MOCK_UPTERM_FAIL
    _assert_exit "host key: launch cleanup failure propagates" 1 "$rc"
    _assert_contains "host key: launch cleanup failure is actionable" \
      "failed to remove the owned Upterm trust snapshot" "$output"
    _assert_file_exists "host key: launch cleanup failure preserves ownership" \
      "$lifecycle_snapshot_owner"
    block_snapshot_rm=0
    _upterm_read_snapshot_owner "$lifecycle_snapshot_owner"
    _upterm_cleanup_known_hosts_snapshot \
      "$_UPTERM_SNAPSHOT_TOKEN" \
      "$(dirname "$lifecycle_snapshot_owner")/$_UPTERM_SNAPSHOT_BASENAME"

    _upterm_acquire_snapshot_owner stale_snapshot_token lifecycle_snapshot
    printf 'stale\n' >"$lifecycle_snapshot"
    sleep 30 &
    stale_active_pid=$!
    _track_test_pid "$stale_active_pid"
    _upterm_write_snapshot_owner replace active "$stale_active_pid" \
