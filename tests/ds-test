    }
    (
      BLOCK_UPTERM_SCAN=1 _share_start "concurrent-first"
    ) >"$concurrent_first_output" 2>&1 &
    concurrent_first_pid=$!
    _track_test_pid "$concurrent_first_pid"
    for ((concurrent_attempt = 0; concurrent_attempt < 500; concurrent_attempt++)); do
      [[ -e "$concurrent_ready" ]] && break
