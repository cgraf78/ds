#!/usr/bin/env bash
# ds-test — unit tests for the ds dev-session launcher.
#
# Creates temp directories to simulate $HOME and tests internal functions
# in isolation. Mocks tmux to avoid real session management.
#
# Usage: ds-test

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# shellcheck source=test-helpers.sh
. "$SCRIPT_DIR/test-helpers.sh"

# ---------------------------------------------------------------------------
# Setup: override HOME, source ds for internal functions
# ---------------------------------------------------------------------------

TEST_HOME=$(_tmpdir)
export HOME="$TEST_HOME"
export CONF_DIR="$TEST_HOME/.config/ds"
mkdir -p "$CONF_DIR"

# Create a minimal profile for testing
cat >"$CONF_DIR/profile-dev.sh" <<'PROFILE'
_profile_dev() {
    local session="$1"
    : # no-op for testing
}
PROFILE

cat >"$CONF_DIR/profile-web.sh" <<'PROFILE'
_profile_web() {
    local session="$1"
    : # no-op for testing
}
PROFILE

export DS_SOURCED=1
export DS_UPTERM_PRIVATE_KEY="$TEST_HOME/.ssh/test_upterm_key"
mkdir -p "$TEST_HOME/.ssh"
printf 'dummy' >"$DS_UPTERM_PRIVATE_KEY"
# shellcheck source=../bin/ds
. "$SCRIPT_DIR/../bin/ds"
# Install and load the upterm share backend for sharing tests
cp "$SCRIPT_DIR/../lib/plugins/share-upterm.sh" "$CONF_DIR/"
# shellcheck source=/dev/null
. "$CONF_DIR/share-upterm.sh"

# Create a mock tmux in a temp bin dir and prepend to PATH
MOCK_BIN=$(_tmpdir)
TMUX_LOG="$MOCK_BIN/tmux.log"

cat >"$MOCK_BIN/tmux" <<'MOCK'
#!/usr/bin/env bash
# Mock tmux that logs calls and simulates responses
echo "tmux $*" >> "${TMUX_LOG:-/dev/null}"
args=("$@")
case "${args[0]:-}" in
    has-session)
        # Check MOCK_SESSIONS for existence
        session="${args[2]#=}"  # strip = prefix
        if [[ " ${MOCK_SESSIONS:-} " == *" $session "* ]]; then
            exit 0
        else
            exit 1
        fi
        ;;
    ls)
        echo "${MOCK_TMUX_LS:-}" | grep -v '^$' || true
        ;;
    set-environment)
        # Track DS_MANAGED sessions: set-environment -t <session> DS_MANAGED 1
        if [[ "${args[3]:-}" == "DS_MANAGED" ]]; then
            export MOCK_DS_MANAGED="${MOCK_DS_MANAGED:-} ${args[2]}"
        fi
        exit 0
        ;;
    show-environment)
        # show-environment -t =<session> DS_MANAGED
        _se_name="${args[2]#=}"
        if [[ " ${MOCK_DS_MANAGED:-} " == *" $_se_name "* ]]; then
            echo "DS_MANAGED=1"
            exit 0
        else
            exit 1
        fi
        ;;
    display-message)
        # Support session name query and info format
        for _a in "${args[@]}"; do
            if [[ "$_a" == *'#{session_name}'* ]]; then
                echo "${MOCK_CURRENT_SESSION:-ds}"
                exit 0
            fi
        done
        echo "1 windows (detached)"
        exit 0
        ;;
    new-session|attach|switch-client|kill-session|rename-window|split-window|new-window|select-window|send-keys)
        exit 0
        ;;
esac
MOCK
chmod +x "$MOCK_BIN/tmux"

cat >"$MOCK_BIN/upterm" <<'MOCK'
#!/usr/bin/env bash
echo "upterm $*" >> "${TMUX_LOG:-/dev/null}"
if [[ "$1" == "host" ]]; then
  # Execute the hosted command (bash -c "...") that writes the admin socket file.
  # Find args after "--" and run them so _share_start's admin socket polling works.
  found_dashdash=0
  hosted_args=()
  for arg; do
    if [[ "$found_dashdash" -eq 1 ]]; then
      hosted_args+=("$arg")
    elif [[ "$arg" == "--" ]]; then
      found_dashdash=1
    fi
  done
  if [[ ${#hosted_args[@]} -gt 0 ]]; then
    # Run hosted command in background (it sleeps forever, so we'll kill it on exit)
    export UPTERM_ADMIN_SOCKET="/tmp/mock-upterm-admin.sock"
    "${hosted_args[@]}" &
    hosted_pid=$!
    trap "kill $hosted_pid 2>/dev/null" EXIT
  fi
  # Write share info to stdout (goes to log file)
  printf '%s\n' "ssh session: ssh test@upterm.example"
  # Keep background process alive briefly if launched with & so kill -0 works.
  sleep "${MOCK_UPTERM_SLEEP:-1}"
  exit 0
fi
if [[ "$1" == "session" && "$2" == "current" ]]; then
  printf '%s\n' "ssh session: ssh test@upterm.example"
  exit 0
fi
exit 0
MOCK
chmod +x "$MOCK_BIN/upterm"

cat >"$MOCK_BIN/zsh" <<'MOCK'
#!/usr/bin/env bash
exit 0
MOCK
chmod +x "$MOCK_BIN/zsh"

export PATH="$MOCK_BIN:$PATH"
export TMUX_LOG

_reset_tmux_log() {
  : >"$TMUX_LOG"
}

_tmux_log() {
  cat "$TMUX_LOG" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Tests: Discovery contracts
# ---------------------------------------------------------------------------

echo "=== Discovery contracts ==="

_contract_root=$(_tmpdir)
_contract_conf="$_contract_root/conf"
_contract_lib="$_contract_root/lib"
mkdir -p "$_contract_conf" "$_contract_lib"
touch \
  "$_contract_conf/connect.conf" \
  "$_contract_conf/profile.conf" \
  "$_contract_conf/profile-dev.sh" \
  "$_contract_conf/share-upterm.sh" \
  "$_contract_lib/connect.conf" \
  "$_contract_lib/profile-dev.sh" \
  "$_contract_lib/profile-lib.sh" \
  "$_contract_lib/profile-extra.conf" \
  "$_contract_lib/share-upterm.sh" \
  "$_contract_lib/share-local.sh"

_saved_conf_dir="$CONF_DIR"
_saved_lib_dir="${DS_LIB_DIR:-}"
CONF_DIR="$_contract_conf"
DS_LIB_DIR="$_contract_lib"

_contract_connect=$(_connect_config_files | sed "s|$_contract_root|ROOT|g" | paste -sd '|' -)
_contract_profile_scripts=$(_profile_script_files | sed "s|$_contract_root|ROOT|g" | paste -sd '|' -)
_contract_profile_configs=$(_profile_config_files | sed "s|$_contract_root|ROOT|g" | paste -sd '|' -)
_contract_share_backends=$(_share_backend_files | sed "s|$_contract_root|ROOT|g" | paste -sd '|' -)

cat >"$_contract_conf/connect.conf" <<'EOF'
shared-user ssh
EOF
cat >"$_contract_lib/connect.conf" <<'EOF'
shared-lib et
EOF
_reset_lookup_contract() {
  CONNECT="ssh"
}
_reset_lookup_contract
lookup_host "shared-lib"
_contract_lib_connect="$CONNECT"
_reset_lookup_contract
lookup_host "shared-user"
_contract_user_connect="$CONNECT"

CONF_DIR="$_saved_conf_dir"
DS_LIB_DIR="$_saved_lib_dir"
unset _saved_conf_dir _saved_lib_dir

_assert_eq "connect configs are additive across user and bundled dirs" \
  "ROOT/conf/connect.conf|ROOT/lib/connect.conf" "$_contract_connect"
_assert_eq "profile scripts let user config override bundled files by basename" \
  "ROOT/conf/profile-dev.sh|ROOT/lib/profile-lib.sh" "$_contract_profile_scripts"
_assert_eq "profile data configs use the shared profile*.conf contract" \
  "ROOT/conf/profile.conf|ROOT/lib/profile-extra.conf" "$_contract_profile_configs"
_assert_eq "share backends let user config override bundled files by basename" \
  "ROOT/conf/share-upterm.sh|ROOT/lib/share-local.sh" "$_contract_share_backends"
_assert_eq "lookup_host reads bundled connect configs with matching basenames" "et" "$_contract_lib_connect"
_assert_eq "lookup_host keeps user connect configs first" "ssh" "$_contract_user_connect"

_saved_conf_dir="$CONF_DIR"
_saved_lib_dir="${DS_LIB_DIR:-}"
_empty_contract_root=$(_tmpdir)
CONF_DIR="$_empty_contract_root/conf"
DS_LIB_DIR="$_empty_contract_root/lib"
mkdir -p "$CONF_DIR" "$DS_LIB_DIR"
_empty_profile_scripts=$(_profile_script_files)
_empty_profile_scripts_rc=$?
_assert_eq "plugin discovery emits no blank record when empty" "" "$_empty_profile_scripts"
_assert_eq "plugin discovery treats empty results as success" "0" "$_empty_profile_scripts_rc"
CONF_DIR="$_saved_conf_dir"
DS_LIB_DIR="$_saved_lib_dir"
unset _saved_conf_dir _saved_lib_dir

# ---------------------------------------------------------------------------
# Tests: Host config lookup
# ---------------------------------------------------------------------------

echo ""
echo "=== Host config lookup ==="

cat >"$CONF_DIR/connect.conf" <<'EOF'
# hostname    connect
desktop        -
fileserver           autossh
EOF

# Reset globals before each lookup test
_reset_lookup() {
  CONNECT="ssh"
}

_reset_lookup
lookup_host "desktop"
_assert_eq "desktop: connect method" "-" "$CONNECT"

_reset_lookup
lookup_host "fileserver"
_assert_eq "fileserver: connect method" "autossh" "$CONNECT"

# Unknown host returns failure, doesn't change globals
_reset_lookup
if lookup_host "unknown-host"; then
  _fail "unknown host should return 1"
else
  _pass "unknown host returns 1"
fi
_assert_eq "unknown host: connect unchanged" "ssh" "$CONNECT"

# Glob pattern matching in connect config
cat >"$CONF_DIR/connect-work.conf" <<'EOF'
dev*          et
mydevbox      autossh
EOF

_reset_lookup
lookup_host "dev2"
_assert_eq "glob dev*: connect" "et" "$CONNECT"

# First match wins (dev* before mydevbox in file order, but mydevbox is
# in a separate file — connect.conf is searched before connect-work.conf)
_reset_lookup
lookup_host "mydevbox"
_assert_eq "mydevbox: connect (connect-work.conf)" "autossh" "$CONNECT"

# Multiple connect.conf files are searched (additive)
_reset_lookup
lookup_host "desktop"
_assert_eq "desktop still found with connect-work.conf present" "-" "$CONNECT"

rm -f "$CONF_DIR/connect-work.conf"

# No connect.conf files at all
rm -f "$CONF_DIR/connect.conf"
_reset_lookup
if lookup_host "anyhost"; then
  _fail "no connect.conf files should return 1"
else
  _pass "no connect.conf files returns 1"
fi

# Restore connect.conf for remaining tests
cat >"$CONF_DIR/connect.conf" <<'EOF'
# hostname    connect
desktop        -
fileserver           autossh
server1       ssh
EOF

# ---------------------------------------------------------------------------
# Tests: Profile discovery
# ---------------------------------------------------------------------------

echo ""
echo "=== Profile discovery ==="

result=$(_profiles)
_assert_contains "discovers ds profile" "ds" "$result"
_assert_contains "discovers dev profile" "dev" "$result"
_assert_contains "discovers web profile" "web" "$result"

# ---------------------------------------------------------------------------
# Tests: Profile resolution
# ---------------------------------------------------------------------------

echo ""
echo "=== Profile resolution ==="

# Empty SESSION defaults to "ds" with ds profile
SESSION="" PROFILE=""
_resolve_profile
_assert_eq "empty SESSION → SESSION=ds" "ds" "$SESSION"
_assert_eq "empty SESSION → PROFILE=ds" "ds" "$PROFILE"

# Exact profile match
SESSION="dev" PROFILE=""
_resolve_profile
_assert_eq "SESSION=dev → PROFILE=dev" "dev" "$PROFILE"
_assert_eq "SESSION=dev unchanged" "dev" "$SESSION"

SESSION="web" PROFILE=""
_resolve_profile
_assert_eq "SESSION=web → PROFILE=web" "web" "$PROFILE"

SESSION="ds" PROFILE=""
_resolve_profile
_assert_eq "SESSION=ds → PROFILE=ds" "ds" "$PROFILE"

# Profile-instance (dash-separated)
SESSION="dev-work" PROFILE=""
_resolve_profile
_assert_eq "dev-work → PROFILE=dev" "dev" "$PROFILE"
_assert_eq "dev-work SESSION preserved" "dev-work" "$SESSION"

SESSION="dev-frontend" PROFILE=""
_resolve_profile
_assert_eq "dev-frontend → PROFILE=dev" "dev" "$PROFILE"

SESSION="web-2" PROFILE=""
_resolve_profile
_assert_eq "web-2 → PROFILE=web" "web" "$PROFILE"

# Multiple dashes — split on first
SESSION="dev-my-project" PROFILE=""
_resolve_profile
_assert_eq "dev-my-project → PROFILE=dev" "dev" "$PROFILE"
_assert_eq "dev-my-project SESSION preserved" "dev-my-project" "$SESSION"

# Arbitrary name → ds profile
SESSION="foo" PROFILE=""
_resolve_profile
_assert_eq "foo → PROFILE=ds" "ds" "$PROFILE"
_assert_eq "foo SESSION preserved" "foo" "$SESSION"

SESSION="foo-bar" PROFILE=""
_resolve_profile
_assert_eq "foo-bar (no profile match) → PROFILE=ds" "ds" "$PROFILE"
_assert_eq "foo-bar SESSION preserved" "foo-bar" "$SESSION"

SESSION="myproject" PROFILE=""
_resolve_profile
_assert_eq "myproject → PROFILE=ds" "ds" "$PROFILE"
_assert_eq "myproject SESSION preserved" "myproject" "$SESSION"

# ---------------------------------------------------------------------------
# Tests: Data profiles (profile*.conf)
# ---------------------------------------------------------------------------

echo ""
echo "=== Data profiles ==="

cat >"$CONF_DIR/profile.conf" <<'CONF'
# name    window   command
argus     argus    argus
claude    claude   claude
notes     notes    nvim ~/notes
bare      bare
b@d       x        y
CONF
_load_data_profiles 2>/dev/null

result=$(_profiles)
_assert_contains "data profile: argus discovered" "argus" "$result"
_assert_contains "data profile: claude discovered" "claude" "$result"
_assert_contains "data profile: notes discovered" "notes" "$result"

if declare -f "_profile_b@d" &>/dev/null; then
  _fail "data profile: unsafe name rejected"
else
  _pass "data profile: unsafe name rejected"
fi

# Data profiles flow through normal resolution, including instance splitting.
SESSION="argus" PROFILE=""
_resolve_profile
_assert_eq "data profile: argus resolves" "argus" "$PROFILE"
SESSION="argus-foo" PROFILE=""
_resolve_profile
_assert_eq "data profile: argus-foo → PROFILE=argus" "argus" "$PROFILE"
_assert_eq "data profile: argus-foo SESSION preserved" "argus-foo" "$SESSION"

# Running a data profile renames window 1 and sends the command.
_reset_tmux_log
_profile_argus "ds"
log=$(_tmux_log)
_assert_contains "data profile: renames window" "rename-window -t ds:1 argus" "$log"
_assert_contains "data profile: sends command" "send-keys -t ds:1 argus C-m" "$log"

# Multi-word commands survive as the trailing remainder of the row.
_reset_tmux_log
_profile_notes "ds"
log=$(_tmux_log)
_assert_contains "data profile: multi-word command preserved" \
  "send-keys -t ds:1 nvim ~/notes C-m" "$log"

# A row with no command renames but sends nothing.
_reset_tmux_log
_profile_bare "ds"
log=$(_tmux_log)
_assert_contains "data profile: window-only renames" "rename-window -t ds:1 bare" "$log"
_assert_not_contains "data profile: window-only sends nothing" "send-keys" "$log"

# bin/ds synthesizes .conf wrappers before sourcing .sh profiles, so a custom
# profile-<name>.sh always overrides a data row. Model that order here.
cat >"$CONF_DIR/profile-argus.sh" <<'PROFILE'
_profile_argus() { tmux send-keys -t "$1:1" "argus_from_sh" C-m; }
PROFILE
# shellcheck source=/dev/null
. "$CONF_DIR/profile-argus.sh"
_reset_tmux_log
_profile_argus "ds"
log=$(_tmux_log)
_assert_contains "data profile: later .sh definition overrides .conf" "argus_from_sh" "$log"
rm -f "$CONF_DIR/profile.conf" "$CONF_DIR/profile-argus.sh"

# ---------------------------------------------------------------------------
# Tests: Session target resolution
# ---------------------------------------------------------------------------

echo ""
echo "=== Session target resolution ==="

# Explicit session — passes through
SESSION="dev" HOST=""
_resolve_session_target
_assert_eq "explicit SESSION preserved" "dev" "$SESSION"

# Remote without session → error
result=$( (
  SESSION="" HOST="myhost"
  _resolve_session_target
) 2>&1 || true)
_assert_contains "remote without session errors" "session name required for remote" "$result"

# No session, no host, no tmux → error
# shellcheck disable=SC2030  # intentional — TMUX set in subshell for isolation
result=$( (
  SESSION="" HOST="" TMUX=""
  _resolve_session_target
) 2>&1 || true)
_assert_contains "no session, no tmux errors" "not inside tmux" "$result"

# Inside tmux, no session → defaults to current session
# shellcheck disable=SC2031  # intentional — TMUX set independently of subshell above
export TMUX="/tmp/tmux-test/default,12345,0"
export MOCK_CURRENT_SESSION="dev-work"
SESSION="" HOST=""
_resolve_session_target
_assert_eq "tmux default: resolves to current session" "dev-work" "$SESSION"
unset TMUX MOCK_CURRENT_SESSION

# ---------------------------------------------------------------------------
# Tests: Upterm sharing backend
# ---------------------------------------------------------------------------

echo ""
echo "=== Upterm sharing backend ==="

# _share_start launches upterm host in the background and polls for an admin
# socket. The mock upterm executes the hosted command to create it, and
# responds to "session current" with share info. Here we verify core behavior.

_reset_tmux_log
export MOCK_SESSIONS=""
export MOCK_DS_MANAGED=""
SESSION="ds"
PROFILE="ds"
DS_SHARE_VIA=""
DS_NO_ATTACH=1
DS_SHARE_INFO_FILE="$(_default_share_info_file)"
DS_UPTERM_PID_FILE="$(_upterm_pid_file)"
result=$(_do_session 2>&1)
log=$(_tmux_log)
_assert_contains "no-attach: creates tmux session" "tmux new-session -d -s ds" "$log"
if echo "$log" | grep -qx 'tmux attach -t =ds'; then
  _fail "no-attach: skips local attach"
else
  _pass "no-attach: skips local attach"
fi

# Test --share action with existing session
_reset_tmux_log
export MOCK_SESSIONS="ds"
DS_SHARE_VIA="upterm"
DS_UPTERM_GITHUB_USER="testuser"
DS_UPTERM_SHARE_TTL="0" # disable TTL for this test to avoid background watchers
SESSION="ds"
HOST=""
# _do_share calls _share_start, which runs the full share flow with mock upterm
result=$(_do_share 2>&1) || true
_assert_not_contains "share action: no 'no session' error for existing session" "no session" "$result"

# Test --share action with nonexistent session
_reset_tmux_log
export MOCK_SESSIONS=""
SESSION="nonexistent"
HOST=""
result=$(_do_share 2>&1) || true
_assert_contains "share action: error for nonexistent session" "no session" "$result"

# Clean up state from share test (kill mock upterm, remove PID/state files)
_pid_f=$(_upterm_pid_file)
if [[ -f "$_pid_f" ]]; then
  _pid=$(cat "$_pid_f" 2>/dev/null || true)
  if [[ "$_pid" =~ ^[0-9]+$ ]]; then kill "$_pid" 2>/dev/null || true; fi
  rm -f "$_pid_f"
fi
rm -f "$DS_SHARE_INFO_FILE" "$(_upterm_admin_file)" "$(_upterm_session_file)" "$(_upterm_log_file)"

# Test --unshare action (no daemon running)
SESSION="ds"
HOST=""
result=$(_do_unshare 2>&1)
_assert_contains "unshare: reports not sharing" "not currently sharing" "$result"

# Test normalization of upterm host output variants (e.g., WSL fallback log parse)
result=$(_upterm_normalize_info $'Command: ssh token123@uptermd.upterm.dev')
_assert_contains "normalize upterm: command format" "ssh: ssh token123@uptermd.upterm.dev" "$result"

# Test reading share info directly from upterm log fallback
log_file="$(_tmpdir)/upterm.log"
printf '%s\n' 'Some startup text' 'Command: ssh abc123@uptermd.upterm.dev' >"$log_file"
result=$(_upterm_read_info_from_log "$log_file")
_assert_contains "log fallback: extracts ssh command" "ssh: ssh abc123@uptermd.upterm.dev" "$result"

# Test PID validation — _share_running rejects non-numeric PID files
pid_dir=$(_tmpdir)
DS_UPTERM_PID_FILE="$pid_dir/test.pid"

echo "not-a-pid" >"$DS_UPTERM_PID_FILE"
if _share_running; then
  _fail "share_running: rejects non-numeric PID"
else
  _pass "share_running: rejects non-numeric PID"
fi

echo "12345; rm -rf /" >"$DS_UPTERM_PID_FILE"
if _share_running; then
  _fail "share_running: rejects PID with injection"
else
  _pass "share_running: rejects PID with injection"
fi

echo "" >"$DS_UPTERM_PID_FILE"
if _share_running; then
  _fail "share_running: rejects empty PID"
else
  _pass "share_running: rejects empty PID"
fi

rm -f "$DS_UPTERM_PID_FILE"
if _share_running; then
  _fail "share_running: rejects missing PID file"
else
  _pass "share_running: rejects missing PID file"
fi

# Test _share_load_config reads share-upterm.conf
cat >"$CONF_DIR/share-upterm.conf" <<'EOF'
# test config
server=myupterm.internal:2222
known-hosts=/path/to/known_hosts
private-key=/path/to/key
github-user=testghuser
authorized-keys=/path/to/authorized_keys
push=user@remotehost
EOF

# Clear env vars so config values take effect
DS_UPTERM_HOST=""
DS_UPTERM_KNOWN_HOSTS=""
DS_UPTERM_PRIVATE_KEY=""
DS_UPTERM_GITHUB_USER=""
DS_UPTERM_AUTHORIZED_KEYS=""
DS_UPTERM_PUSH=""
_share_load_config
_assert_eq "config: server" "myupterm.internal:2222" "$DS_UPTERM_HOST"
_assert_eq "config: known-hosts" "/path/to/known_hosts" "$DS_UPTERM_KNOWN_HOSTS"
_assert_eq "config: private-key" "/path/to/key" "$DS_UPTERM_PRIVATE_KEY"
_assert_eq "config: github-user" "testghuser" "$DS_UPTERM_GITHUB_USER"
_assert_eq "config: authorized-keys" "/path/to/authorized_keys" "$DS_UPTERM_AUTHORIZED_KEYS"
_assert_eq "config: push" "user@remotehost" "$DS_UPTERM_PUSH"

# Env vars override config values
DS_UPTERM_HOST="envhost:3333"
DS_UPTERM_KNOWN_HOSTS="/env/known_hosts"
DS_UPTERM_PRIVATE_KEY="/env/key"
DS_UPTERM_GITHUB_USER="envuser"
DS_UPTERM_AUTHORIZED_KEYS="/env/authorized_keys"
DS_UPTERM_PUSH="envuser@envhost"
_share_load_config
_assert_eq "env override: server" "envhost:3333" "$DS_UPTERM_HOST"
_assert_eq "env override: known-hosts" "/env/known_hosts" "$DS_UPTERM_KNOWN_HOSTS"
_assert_eq "env override: private-key" "/env/key" "$DS_UPTERM_PRIVATE_KEY"
_assert_eq "env override: github-user" "envuser" "$DS_UPTERM_GITHUB_USER"
_assert_eq "env override: authorized-keys" "/env/authorized_keys" "$DS_UPTERM_AUTHORIZED_KEYS"
_assert_eq "env override: push" "envuser@envhost" "$DS_UPTERM_PUSH"

# share-ttl config key loaded
cat >"$CONF_DIR/share-upterm.conf" <<'EOF'
server=myupterm.internal:2222
share-ttl=1800
EOF
DS_UPTERM_HOST=""
DS_UPTERM_SHARE_TTL=""
_share_load_config
_assert_eq "config: share-ttl" "1800" "$DS_UPTERM_SHARE_TTL"

# Env var overrides share-ttl from config
DS_UPTERM_SHARE_TTL="600"
_share_load_config
_assert_eq "env override: share-ttl" "600" "$DS_UPTERM_SHARE_TTL"

# Missing config file is silently ignored
rm -f "$CONF_DIR/share-upterm.conf"
DS_UPTERM_HOST=""
DS_UPTERM_PUSH=""
DS_UPTERM_SHARE_TTL=""
_share_load_config
_assert_eq "missing config: server empty" "" "$DS_UPTERM_HOST"
_assert_eq "missing config: push empty" "" "$DS_UPTERM_PUSH"
_assert_eq "missing config: share-ttl empty" "" "$DS_UPTERM_SHARE_TTL"

# ---------------------------------------------------------------------------
# Tests: Share TTL watcher
# ---------------------------------------------------------------------------

echo ""
echo "=== Share TTL watcher ==="

# Add a mock setsid that just runs its args directly (no new process group
# needed in tests — we just need to verify the watcher pid file is created
# and the watcher can be cancelled).
cat >"$MOCK_BIN/setsid" <<'MOCK'
#!/usr/bin/env bash
# Run in background so sleep doesn't block the test process.
"$@" &
MOCK
chmod +x "$MOCK_BIN/setsid"

# Add a mock ds that records --unshare calls
DS_UNSHARE_LOG="$MOCK_BIN/ds-unshare.log"
cat >"$MOCK_BIN/ds" <<MOCK
#!/usr/bin/env bash
echo "ds \$*" >> "${DS_UNSHARE_LOG}"
MOCK
chmod +x "$MOCK_BIN/ds"

# --- _upterm_start_ttl_watcher creates a pid file ---
_reset_tmux_log
DS_UPTERM_PID_FILE="$(_upterm_pid_file)"
DS_UPTERM_SHARE_TTL=""
: >"$DS_UNSHARE_LOG"
_upterm_start_ttl_watcher 60 "ds"
ttl_pid_file=$(_upterm_ttl_pid_file)
_assert_file_exists "watcher: ttl pid file created" "$ttl_pid_file"
watcher_pid=$(cat "$ttl_pid_file" 2>/dev/null || true)
if [[ "$watcher_pid" =~ ^[0-9]+$ ]]; then
