    # The source path is trusted before open, but a detectable swap to a
    # symlink during setup must still fail rather than following it.
    source_swap_target="$lifecycle_dir/source-swap-target"
    source_swap_original="$lifecycle_dir/source-swap-original"
    printf '%s' "$snapshot_original" >"$snapshot_source"
    printf '%s' "$snapshot_original" >"$source_swap_target"
    DS_UPTERM_KNOWN_HOSTS="$snapshot_source"
    saved_ensure_state_dir=$(declare -f _ensure_state_dir)
    _ensure_state_dir() {
      mkdir -p "$DS_STATE_DIR"
      if [[ "${SWAP_KNOWN_HOSTS_DURING_SETUP:-0}" == 1 ]]; then
        mv "$snapshot_source" "$source_swap_original"
        ln -s "$source_swap_target" "$snapshot_source"
        SWAP_KNOWN_HOSTS_DURING_SETUP=0
      fi
    }
    _reset_tmux_log
    set +e
    output=$(SWAP_KNOWN_HOSTS_DURING_SETUP=1 _share_start "source-open-swap" 2>&1)
    rc=$?
    set -e
    eval "$saved_ensure_state_dir"
    _assert_exit "host key: a source swapped to a symlink before open fails closed" 1 "$rc"
    _assert_contains "host key: source-open swap rejection is actionable" \
