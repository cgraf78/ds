    fi
    rm -f "$snapshot_source"
    mv "$source_swap_original" "$snapshot_source"

    DS_UPTERM_KNOWN_HOSTS="$snapshot_source"
    export MOCK_UPTERM_FAIL=1
    failed_start_signals="$lifecycle_dir/failed-start-signals"
    # shellcheck disable=SC2329 # Failed-start cleanup invokes this signal audit double.
    kill() {
      if [[ "${1:-}" != -0 ]]; then
        builtin printf '%s\n' "$*" >>"$failed_start_signals"
      fi
      command kill "$@"
    }
    _reset_tmux_log
    set +e
    output=$(_share_start "launch-failure" 2>&1)
    rc=$?
    set -e
    unset MOCK_UPTERM_FAIL
    unset -f kill
    _assert_exit "host key: an Upterm launch failure propagates" 1 "$rc"
    _assert_contains "host key: an Upterm launch failure is actionable" \
      "upterm exited before publishing share info" "$output"
    _assert_file_missing "host key: launch failure removes its trust snapshot" \
      "$lifecycle_snapshot"
    _assert_file_missing "host key: launch failure removes its pid file" "$lifecycle_pid"
    _assert_file_missing "host key: launch failure removes its session file" \
      "$(_upterm_session_file)"
    _assert_file_missing "host key: launch failure removes its log file" \
      "$(_upterm_log_file)"
    _assert_file_missing "host key: launch failure leaves no snapshot temporary file" \
      "${lifecycle_snapshot}.tmp"
    _assert_file_missing "host key: failed-start cleanup sends no external signal" \
      "$failed_start_signals"

    stale_snapshot_token=""
    _upterm_acquire_snapshot_owner stale_snapshot_token lifecycle_snapshot
    printf 'stale\n' >"$lifecycle_snapshot"
    sleep 30 &
    stale_active_pid=$!
    _track_test_pid "$stale_active_pid"
    _upterm_write_snapshot_owner replace active "$stale_active_pid" \
      "$stale_snapshot_token" "$lifecycle_snapshot"
    _upterm_write_pid_file \
      "$lifecycle_pid" "$stale_active_pid" "$stale_snapshot_token"
    kill "$stale_active_pid" 2>/dev/null || true
    wait "$stale_active_pid" 2>/dev/null || true
    stale_control=$(_upterm_control_dir "$stale_snapshot_token")
    _upterm_create_control_dir "$stale_snapshot_token"
    _upterm_supervisor_write_status \
      "$stale_control/done" "$stale_snapshot_token" exited
    _share_running >/dev/null 2>&1 || true
    _assert_file_missing "host key: dead share state removes a stale trust snapshot" \
      "$lifecycle_snapshot"
    _assert_file_missing "host key: dead share state removes stale snapshot ownership" \
      "$lifecycle_snapshot_owner"

