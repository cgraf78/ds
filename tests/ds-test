    printf '%s' "$snapshot_original" >"$snapshot_source"
    ln -s "$snapshot_source" "$lifecycle_dir/symlink-known-hosts"
    DS_UPTERM_KNOWN_HOSTS="$lifecycle_dir/symlink-known-hosts"
    _reset_tmux_log
    set +e
