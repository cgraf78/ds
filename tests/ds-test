  has-session)
    exit 1
    ;;
esac
exit 0
SH
chmod +x "$_runtime_mock_bin/tmux"

# A split install only works if the runtime honors DS_LIB_DIR too. Use a clean
# HOME so the dev profile can only come from the custom bundled plugin path.
HOME="$_runtime_home" \
  PATH="$_runtime_mock_bin:$PATH" \
  DS_LIB_DIR="$_custom_inst_root/plugins" \
  DS_STATE_DIR="$_runtime_home/.local/state/ds" \
  DS_SHELL_NAME="bash" \
  DS_SOURCED="" \
  DS_TEST_TMUX_LOG="$_runtime_tmux_log" \
  "$_custom_inst_root/bin/ds" dev --no-attach
_runtime_tmux_calls=$(cat "$_runtime_tmux_log")
_assert_contains "installed ds: custom DS_LIB_DIR loads bundled dev profile" \
  "split-window" "$_runtime_tmux_calls"

_source_link_root=$(_tmpdir)
_source_link_home=$(_tmpdir)
_source_link_mock_bin=$(_tmpdir)
_source_link_tmux_log="$(_tmpdir)/tmux.log"
mkdir -p "$_source_link_root/bin" "$_source_link_home/.config/ds"
ln -s "$SCRIPT_DIR/../bin/ds" "$_source_link_root/bin/ds"
cat >"$_source_link_mock_bin/tmux" <<'SH'
#!/usr/bin/env bash
printf 'tmux %s\n' "$*" >>"$DS_TEST_TMUX_LOG"
case "${1:-}" in
  has-session)
    exit 1
    ;;
esac
exit 0
SH
chmod +x "$_source_link_mock_bin/tmux"

# shdeps repo installs expose ds as a symlink into the checkout, not through
# install.sh. With DS_LIB_DIR unset, that path must still find repo lib/plugins.
HOME="$_source_link_home" \
  PATH="$_source_link_mock_bin:$PATH" \
  DS_LIB_DIR="" \
  DS_STATE_DIR="$_source_link_home/.local/state/ds" \
  DS_SHELL_NAME="bash" \
  DS_SOURCED="" \
  DS_TEST_TMUX_LOG="$_source_link_tmux_log" \
  "$_source_link_root/bin/ds" dev --no-attach
_source_link_tmux_calls=$(cat "$_source_link_tmux_log")
_assert_contains "symlinked checkout ds: repo lib/plugins loads bundled dev profile" \
  "split-window" "$_source_link_tmux_calls"

_ci_workflow=$(cat "$SCRIPT_DIR/../.github/workflows/ci.yml")
_ds_ci=$(cat "$SCRIPT_DIR/ds-ci")
_assert_contains "CI: pins shared ShellCheck inventory revision" \
  'cgraf78/actions/.github/workflows/shell-ci.yml@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c' \
  "$_ci_workflow"
_assert_contains "CI: delegates the typed shell inventory" \
  'shellcheck-inventory-path: .github/shellcheck-files.txt' "$_ci_workflow"
_assert_contains "CI: runtime skips only delegated ShellCheck" \
  'test-command: DS_SKIP_SHELLCHECK=1 bash tests/ds-ci' "$_ci_workflow"
_assert_not_contains "CI: runtime profile does not install ShellCheck" \
  'profiles: base,openssh-netcat-lsof,procps,shellcheck' "$_ci_workflow"
_assert_contains "CI: Termux keeps the runtime profile" \
  'termux-profiles: runtime' "$_ci_workflow"
_assert_not_contains "CI: Termux does not run ShellCheck" \
  'shellcheck -x' "$_ci_workflow"
_assert_contains "CI: Termux retains the ds help smoke" \
  'timeout 30 bash bin/ds --help' "$_ci_workflow"
_assert_contains "local runner: delegated mode has an exact lint guard" \
  "[[ \"\${DS_SKIP_SHELLCHECK:-0}\" != 1 ]]" "$_ds_ci"
_assert_contains "ShellCheck: ds-test preserves SC2317 policy in-file" \
  '# shellcheck disable=SC2317' "$(head -n 10 "$SCRIPT_DIR/ds-test")"
_assert_contains "ShellCheck: helpers preserve SC2317 policy in-file" \
  '# shellcheck disable=SC2317' "$(head -n 10 "$SCRIPT_DIR/test-helpers.sh")"

# Restore connect.conf
cat >"$CONF_DIR/connect.conf" <<'EOF'
# hostname    connect
desktop        -
fileserver           autossh
server1       ssh
EOF

_test_worktree_leaks=0
for _test_ledger_entry in "$TEST_PID_LEDGER"/*; do
  [[ -e "$_test_ledger_entry" ]] || continue
  _test_leak_pid=${_test_ledger_entry##*/}
  read -r _test_weekday _test_month _test_day _test_clock _test_year \
    <"$_test_ledger_entry"
  _test_leak_identity="$_test_weekday $_test_month $_test_day $_test_clock $_test_year"
  _test_pid_still_live "$_test_leak_pid" "$_test_leak_identity" || continue
  _test_leak_args=$(LC_ALL=C ps -ww -o command= -p "$_test_leak_pid" 2>/dev/null || true)
  case "$_test_leak_args" in
    "sleep 86400" | *"ds-test-suite."*"upterm.admin"*"sleep 86400"*)
      _test_worktree_leaks=$((_test_worktree_leaks + 1))
      ;;
  esac
done
_assert_eq "test cleanup: no adopted hosted commands or sleep 86400 descendants" \
  "0" "$_test_worktree_leaks"

_test_summary
