#!/usr/bin/env bash
# ds — connect to (or create) a tmux dev session, locally or on a remote host.
#
# Usage: ds [session] [@host]          create or attach to a session
#        ds -l [@host]                 list active ds sessions
#        ds -k [session] [@host]       kill a ds session (defaults to current)
#        ds --killall [@host]          kill all ds sessions
#        ds --share [session]          share a session (defaults to current)
#        ds --unshare [session]        stop sharing (defaults to current)
#        ds resurrect save FILE        save ds metadata into a resurrect snapshot
#        ds resurrect begin            mark a resurrect restore in progress
#        ds resurrect restore [FILE]   restore ds metadata from a snapshot
#        ds init <bash|zsh>            print shell integration snippet
#
# Sessions:    profile name, profile-instance, or any name (e.g., dev, dev-work, myproject)
# User config: $XDG_CONFIG_HOME/ds (absolute XDG root; ~/.config fallback)
# Profiles:    profile-<name>.sh   (define _profile_<name>)
# Connections: connect-<method>.sh (define _connect_<method>)
# Share:       share-<backend>.sh   (define _share_start, _share_stop, etc.)
# Hosts:       connect*.conf        (hostname → connect method)
#
# Auto-attach: set DS_SSH_AUTO_ATTACH before eval "$(ds init <bash|zsh>)"
#              DS_SSH_AUTO_ATTACH=ds      → auto-attach to default "ds" session
#              DS_SSH_AUTO_ATTACH=dev     → auto-attach to "dev" session
#              NO_TMUX=1                  → skip for one login
#              (also requires a real terminal: a login with no controlling tty,
#               e.g. a tunnel/command session, is skipped even when interactive)

_xdg_dir() {
  local value="$1" fallback="$2" suffix="$3" variable="$4"

  case "$value" in
    /*) printf '%s/%s\n' "${value%/}" "$suffix" ;;
    *)
      if [[ -z "${HOME:-}" ]]; then
        printf 'ds: HOME is required when %s is unset or relative\n' "$variable" >&2
        return 1
      fi
      printf '%s/%s/%s\n' "${HOME%/}" "${fallback#/}" "$suffix"
      ;;
  esac
}

if [[ -z "${DS_LIB_DIR:-}" ]]; then
  # A normal install keeps bundled plugins next to the binary, but packagers and
  # tests can intentionally split those paths. Treat an explicit DS_LIB_DIR as
  # the runtime contract and only fall back to self-relative discovery.
  _ds_self="$0"
  if [[ -L "$_ds_self" ]]; then
    # readlink -f isn't portable (macOS); resolve one level which is enough
    _ds_self="$(cd "$(dirname "$_ds_self")" && readlink "$(basename "$_ds_self")")"
    # Handle relative symlink targets
    [[ "$_ds_self" != /* ]] && _ds_self="$(cd "$(dirname "$0")" && cd "$(dirname "$_ds_self")" && pwd)/$(basename "$_ds_self")"
  fi
  # Installed copies use the namespaced lib/ds/plugins path. Source checkouts
  # keep plugin sources in lib/plugins, so fall back there for direct repo
  # execution and tests without weakening the installed default.
  _ds_lib_dir=""
  if _ds_lib_dir="$(cd "$(dirname "$_ds_self")/../lib/ds/plugins" 2>/dev/null && pwd)"; then
    DS_LIB_DIR="$_ds_lib_dir"
  elif _ds_lib_dir="$(cd "$(dirname "$_ds_self")/../lib/plugins" 2>/dev/null && pwd)"; then
    DS_LIB_DIR="$_ds_lib_dir"
  else
    DS_LIB_DIR=""
  fi
  unset _ds_self _ds_lib_dir
fi
if ! CONF_DIR="$(_xdg_dir "${XDG_CONFIG_HOME:-}" .config ds XDG_CONFIG_HOME)"; then
  if [[ -n "${DS_SOURCED:-}" ]]; then
    return 1
  fi
  exit 1
fi
ACTION="session"
PROFILE=""
SESSION=""
CONNECT_OVERRIDE=""
HOST=""
CONNECT="ssh"
INIT_SHELL=""
RESURRECT_FILE=""
DS_SHARE_VIA="${DS_SHARE_VIA:-}"
DS_NO_ATTACH="${DS_NO_ATTACH:-0}"
DS_SHARE_INFO_FILE="${DS_SHARE_INFO_FILE:-}"
if [[ -z "${DS_STATE_DIR:-}" ]]; then
  if ! DS_STATE_DIR="$(_xdg_dir "${XDG_STATE_HOME:-}" .local/state ds XDG_STATE_HOME)"; then
    if [[ -n "${DS_SOURCED:-}" ]]; then
      return 1
    fi
    exit 1
  fi
fi
FORWARDS=()
R_FORWARDS=()

_DS_CONNECT_CONFIG_GLOB='connect*.conf'
_DS_PROFILE_CONFIG_GLOB='profile*.conf'
_DS_PROFILE_SCRIPT_GLOB='profile-*.sh'
_DS_SHARE_BACKEND_GLOB='share-*.sh'
_DS_HOST_LABEL_FORMAT='#{?@hostname_alias,#{@hostname_alias},#{host_short}}'
_DS_HOST_LABEL_SEPARATOR=':'
_DS_PANE_BORDER_HOOK='after-new-window[99]'
# Bump when DS-owned label setup changes. Session-local user changes remain
# authoritative until then instead of being rewritten on every attachment.
_DS_STATUS_LABELS_VERSION='1'

_usage() {
  echo "Usage: ds [session] [@host]          create or attach to a session"
  echo "       ds -l [@host]                 list active ds sessions"
  echo "       ds -k [session] [@host]       kill a ds session (defaults to current)"
  echo "       ds --killall [@host]          kill all ds sessions"
  echo "       ds --share [session]          share a session (defaults to current)"
  echo "       ds --unshare [session]        stop sharing (defaults to current)"
  echo "       ds resurrect save FILE        save ds metadata into a resurrect snapshot"
  echo "       ds resurrect begin            mark a resurrect restore in progress"
  echo "       ds resurrect restore [FILE]   restore ds metadata from a snapshot"
  echo "       ds init <bash|zsh>            print shell integration snippet"
  echo ""
  echo "Options:"
  echo "  -c, --connect METHOD   override connect method (ssh, autossh, et, ...)"
  echo "  -L, --forward LOCAL:REMOTE   forward local port to remote (repeatable, ssh -L shorthand)"
  echo "  -R, --reverse REMOTE:LOCAL   forward remote port to local (repeatable, ssh -R shorthand)"
  echo "  --share-via BACKEND    share backend to use (e.g. upterm)"
  echo "  --no-attach            create session without attaching"
  echo ""
  echo "Sessions can be a profile name (dev), profile-instance (dev-work),"
  echo "or any arbitrary name (myproject). Arbitrary names use the default"
  echo "ds profile (plain tmux). Default session is 'ds'."
  echo ""
  echo "Examples:"
  echo "  ds                     start or attach to default 'ds' session"
  echo "  ds dev                 start or attach to 'dev' profile session"
  echo "  ds dev-work            second 'dev' instance named 'dev-work'"
  echo "  ds myproject           plain tmux session named 'myproject'"
  echo "  ds @nas                default session on remote host 'nas'"
  echo "  ds dev @nas            'dev' session on remote host"
  echo "  ds dev @nas -c et      remote session via eternal terminal"
  echo "  ds -l @nas             list sessions on remote host"
}

# --- Shell selection ---

_shell_name() {
  local shell="${DS_SHELL_NAME:-}"
  local parent=""

  if [[ -z "$shell" ]] && command -v ps >/dev/null 2>&1; then
    parent="$(ps -p "$PPID" -o comm= 2>/dev/null || true)"
    parent="${parent##*/}"
    parent="${parent#-}"
    [[ -n "$parent" ]] && shell="$parent"
  fi

  if [[ -z "$shell" && -n "${SHELL:-}" ]]; then
    shell="${SHELL##*/}"
  fi

  if [[ -n "$shell" ]]; then
    printf '%s\n' "$shell"
  else
    printf 'bash\n'
  fi
}

_shell_path() {
  _shell_path_for "$(_shell_name)"
}

_shell_path_for() {
  local shell="$1"

  if command -v -- "$shell" >/dev/null 2>&1; then
    command -v -- "$shell"
    return
  fi

  if [[ -n "${SHELL:-}" && -x "${SHELL:-}" ]]; then
    printf '%s\n' "$SHELL"
    return
  fi

  printf '/bin/bash\n'
}

_shell_login_cmd() {
  _shell_login_cmd_for "$(_shell_name)"
}

_shell_login_cmd_for() {
  local shell="$1"
  local shell_path
  shell_path="$(_shell_path_for "$shell")"
  printf 'exec %q -l' "$shell_path"
}

# --- Plugin discovery ---
# Search for a plugin file by name, checking user config first, then bundled.
_find_plugin() {
  local name="$1"
  if [[ -f "$CONF_DIR/$name" ]]; then
    echo "$CONF_DIR/$name"
  elif [[ -n "${DS_LIB_DIR:-}" && -f "$DS_LIB_DIR/$name" ]]; then
    echo "$DS_LIB_DIR/$name"
  else
    return 1
  fi
}

# Glob for plugin files matching a pattern, searching both dirs (user overrides bundled).
_glob_plugins() {
  local pattern="$1"
  local -A seen
  local -a files=()
  local f base
  for f in "$CONF_DIR"/$pattern; do
    [[ -f "$f" ]] || continue
    base="${f##*/}"
    seen["$base"]=1
    files+=("$f")
  done
  if [[ -n "${DS_LIB_DIR:-}" ]]; then
    for f in "$DS_LIB_DIR"/$pattern; do
      [[ -f "$f" ]] || continue
      base="${f##*/}"
      [[ -n "${seen[$base]:-}" ]] && continue
      seen["$base"]=1
      files+=("$f")
    done
  fi
  ((${#files[@]} == 0)) && return 0
  printf '%s\n' "${files[@]}"
}

# Host configs are additive, unlike plugins: a user's connect.conf should not
# hide a bundled connect.conf with the same basename. Lookup order still favors
# user config first so local host aliases can win before bundled defaults.
_connect_config_files() {
  local f
  for f in "$CONF_DIR"/$_DS_CONNECT_CONFIG_GLOB; do
    [[ -f "$f" ]] && printf '%s\n' "$f"
  done
  if [[ -n "${DS_LIB_DIR:-}" ]]; then
    for f in "$DS_LIB_DIR"/$_DS_CONNECT_CONFIG_GLOB; do
      [[ -f "$f" ]] && printf '%s\n' "$f"
    done
  fi
}

_profile_config_files() {
  _glob_plugins "$_DS_PROFILE_CONFIG_GLOB"
}

_profile_script_files() {
  _glob_plugins "$_DS_PROFILE_SCRIPT_GLOB"
}

_share_backend_files() {
  _glob_plugins "$_DS_SHARE_BACKEND_GLOB"
}

_shell_literal() {
  printf '%q' "$1"
}

_posix_shell_literal() {
  local escaped=${1//\'/\'\\\'\'}
  printf "'%s'" "$escaped"
}

_remote_state_file_literal() {
  case "$1" in
    "" | . | .. | */*)
      echo "ds: remote state filename must be one non-empty basename component" >&2
      return 2
      ;;
  esac
  _posix_shell_literal "$1"
}

_remote_state_dir_prelude() {
  cat <<'EOF'
_ds_state_dir=${DS_STATE_DIR:-}
if [ -z "$_ds_state_dir" ]; then
  case ${XDG_STATE_HOME:-} in
    /*) _ds_state_dir=${XDG_STATE_HOME%/}/ds ;;
    *)
      if [ -z "${HOME:-}" ]; then
        echo "ds: HOME is required when XDG_STATE_HOME is unset or relative" >&2
        exit 1
      fi
      _ds_state_dir=$HOME/.local/state/ds
      ;;
  esac
fi
EOF
}

_remote_state_write_command() {
  local file_q
  file_q=$(_remote_state_file_literal "$1") || return
  _remote_state_dir_prelude
  cat <<EOF
umask 077
mkdir -p "\$_ds_state_dir" || exit
chmod 700 "\$_ds_state_dir" || exit
_ds_file=\$_ds_state_dir/$file_q
if [ -d "\$_ds_file" ]; then
  echo "ds: remote state destination is a directory: \$_ds_file" >&2
  exit 1
fi
_ds_tmp_dir=\$_ds_state_dir/.ds-state.\$\$
mkdir "\$_ds_tmp_dir" || exit
trap 'rm -rf "\$_ds_tmp_dir"' 0 1 2 15
_ds_tmp=\$_ds_tmp_dir/payload
cat >"\$_ds_tmp" || exit
chmod 600 "\$_ds_tmp" || exit
mv -f "\$_ds_tmp" "\$_ds_file" || exit
rmdir "\$_ds_tmp_dir" || exit
trap - 0 1 2 15
EOF
}

_remote_state_remove_command() {
  local file_q
  file_q=$(_remote_state_file_literal "$1") || return
  _remote_state_dir_prelude
  # shellcheck disable=SC2016 # The state directory expands on the remote host.
  printf 'rm -f "$_ds_state_dir"/%s\n' "$file_q"
}

_emit_completion_file_contract() {
  local indent="${1:-}"

  # Shell snippets must consume the same paths the generating ds process chose.
  # Emitting literals keeps Bash and Zsh from reimplementing XDG precedence.
  printf '%slocal conf_dir=%s\n' "$indent" "$(_shell_literal "$CONF_DIR")"
  printf '%slocal connect_config_glob=%s\n' "$indent" "$(_shell_literal "$_DS_CONNECT_CONFIG_GLOB")"
  printf '%slocal profile_config_glob=%s\n' "$indent" "$(_shell_literal "$_DS_PROFILE_CONFIG_GLOB")"
  printf '%slocal profile_script_glob=%s\n' "$indent" "$(_shell_literal "$_DS_PROFILE_SCRIPT_GLOB")"
}

_emit_handoff_file_contract() {
  printf '_ds_f=%s\n' "$(_shell_literal "$DS_STATE_DIR/attach-next")"
}

# --- Profile layouts ---

_profile_ds() {
  : # default tmux window is already what we want
}

# Run a trivial single-command profile: rename window 1 and send one command.
# Data profiles (profile*.conf rows) are realized as _profile_<name> wrappers
# around this, so they flow through the normal profile pipeline unchanged.
_profile_run_command() {
  local session="$1" window="$2" command="$3"
  [[ -n "$window" ]] && tmux rename-window -t "$session:1" "$window"
  [[ -n "$command" ]] && tmux send-keys -t "$session:1" "$command" C-m
  # Never propagate the falsy result of an empty-command guard: a profile that
  # only renames the window must still report success to set -e callers.
  return 0
}

# Synthesize _profile_<name> wrappers from profile*.conf rows so trivial
# single-command profiles can be declared as data instead of one near-identical
# profile-<name>.sh per profile. Each row is "name window command...", where
# command is the rest of the line (may contain spaces). Runs before the .sh
# source loop below, so a custom .sh layout of the same name overrides a data
# row. eval is required to define a dynamically-named function; the name is
# validated as an identifier and the row's values are %q-quoted, so row content
# cannot inject code.
_load_data_profiles() {
  local file name window command
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    while read -r name window command; do
      [[ -z "$name" || "$name" == \#* ]] && continue
      if [[ ! "$name" =~ ^[A-Za-z0-9_]+$ ]]; then
        printf 'ds: ignoring invalid profile name %q in %s\n' "$name" "$file" >&2
        continue
      fi
      eval "_profile_${name}() { _profile_run_command \"\$1\" $(printf %q "$window") $(printf %q "$command"); }"
    done <"$file"
  done < <(_profile_config_files)
}
_load_data_profiles

while IFS= read -r _profile_file; do
  [[ -n "$_profile_file" ]] || continue
  # shellcheck source=/dev/null
  . "$_profile_file"
done < <(_profile_script_files)
unset _profile_file

# List valid profile names (derived from discovered _profile_* functions).
_profiles() {
  declare -F | sed -n 's/.*_profile_//p' | sort
}

# --- Host config ---

# Look up a hostname in all connect*.conf files (user config + bundled, additive).
# Sets CONNECT from the first matching entry.
# Returns 1 if no match was found (script defaults apply).
# Hostnames support glob patterns (e.g., server* matches server1, server2).
lookup_host() {
  local target="$1"
  local f
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    while read -r name connect; do
      [[ -z "$name" || "$name" == \#* ]] && continue
      # shellcheck disable=SC2053  # intentional glob matching
      if [[ "$target" == $name ]]; then
        CONNECT="$connect"
        return 0
      fi
    done <"$f"
  done < <(_connect_config_files)
  return 1
}

# --- State helpers ---

_ensure_state_dir() {
  mkdir -p "$DS_STATE_DIR"
  chmod 700 "$DS_STATE_DIR" 2>/dev/null || true
}

_state_file_prefix() {
  printf '%s/%s' "$DS_STATE_DIR" "ds"
}

# --- Share interface ---
# Backends are loaded from share-<backend>.sh and must define:
#   _share_start <session>     start sharing
#   _share_stop <session>      stop sharing
#   _share_info                print current share info
#   _share_running             return 0 if sharing is active
#   _share_current_session     print name of shared session
#   _share_load_config         load backend-specific config
#   _share_obviously_inactive  optional cheap predicate for read-only listing

_write_share_info() {
  local content="$1"
  [[ -n "${DS_SHARE_INFO_FILE:-}" ]] || return 0
  _ensure_state_dir
  local old_umask
  old_umask=$(umask)
  umask 077
  printf '%s\n' "$content" >"$DS_SHARE_INFO_FILE"
  umask "$old_umask"
  chmod 600 "$DS_SHARE_INFO_FILE" 2>/dev/null || true
}

_show_share_info() {
  [[ -n "${DS_SHARE_INFO_FILE:-}" && -f "$DS_SHARE_INFO_FILE" ]] || return 0
  cat "$DS_SHARE_INFO_FILE"
}

_default_share_info_file() {
  echo "$(_state_file_prefix).share"
}

# Load a share backend plugin. Sets up _share_* functions.
_load_share_backend() {
  local backend="$1"
  local plugin
  plugin=$(_find_plugin "share-${backend}.sh") || {
    echo "ds: unknown share backend '$backend' (no plugin found)" >&2
    exit 1
  }
  # shellcheck source=/dev/null
  . "$plugin"
}

# Stubs for when no share backend is loaded.
_share_running() { return 1; }
_share_current_session() { :; }
_share_load_config() { :; }
_share_obviously_inactive() { return 1; }
_share_reset_stubs() {
  _share_running() { return 1; }
  _share_current_session() { :; }
  _share_load_config() { :; }
  _share_obviously_inactive() { return 1; }
}

# --- Tmux helpers ---

# Attach to an existing tmux session, or switch to it if already inside tmux.
# No exec — returns after tmux detaches so the calling shell can exit cleanly.
# Uses = prefix for exact session name matching.
_attach() {
  local session="$1"
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "=$session"
  else
    tmux attach -t "=$session"
  fi
}

_status_left_with_host() {
  local status_left="$1"

  if [[ -z "$status_left" ]]; then
    printf '[ %s%s#S ] ' "$_DS_HOST_LABEL_FORMAT" "$_DS_HOST_LABEL_SEPARATOR"
    return
  fi

  if _status_left_has_session "$status_left" && _status_left_has_host "$status_left"; then
    printf '%s' "$status_left"
  elif [[ "$status_left" == *'#{session_name}'* ]]; then
    printf '%s' "${status_left//'#{session_name}'/"$_DS_HOST_LABEL_FORMAT$_DS_HOST_LABEL_SEPARATOR#{session_name}"}"
  elif [[ "$status_left" == *'#S'* ]]; then
    printf '%s' "${status_left//'#S'/"$_DS_HOST_LABEL_FORMAT$_DS_HOST_LABEL_SEPARATOR#S"}"
  else
    printf '[ %s%s#S ] %s' "$_DS_HOST_LABEL_FORMAT" "$_DS_HOST_LABEL_SEPARATOR" "$status_left"
  fi
}

_status_left_has_session() {
  case "$1" in
    *'#{session_name}'* | *'#S'*)
      return 0
      ;;
  esac
  return 1
}

_status_left_has_host() {
  case "$1" in
    *"$_DS_HOST_LABEL_FORMAT"* | \
      *'#{?@hostname_alias,#{@hostname_alias},#{host_short}}'* | \
      *'#{host_short}'* | \
      *'#{host}'* | \
      *'#H'*)
      return 0
      ;;
  esac
  return 1
}

_remove_literal() {
  local value="$1"
  local needle="$2"
  local result=""

  # Tmux formats contain glob metacharacters, so Bash's pattern replacement
  # cannot safely remove them as literals.
  while [[ -n "$value" ]]; do
    if [[ "$value" == "$needle"* ]]; then
      value="${value:${#needle}}"
    else
      result+="${value:0:1}"
      value="${value:1}"
    fi
  done
  printf '%s' "$result"
}

_pane_border_without_host() {
  local pane_border="$1"
  local cleaned="$pane_border"
  local alias_host_short='#{?@hostname_alias,#{@hostname_alias},#{host_short}}'
  local alias_h='#{?@hostname_alias,#{@hostname_alias},#H}'
  local host_short='#{host_short}'
  local host='#{host}'

  cleaned="$(_remove_literal "$cleaned" "$alias_host_short")"
  cleaned="$(_remove_literal "$cleaned" "$alias_h")"
  cleaned="$(_remove_literal "$cleaned" "$host_short")"
  cleaned="$(_remove_literal "$cleaned" "$host")"
  cleaned="$(_remove_literal "$cleaned" '#H')"
  if [[ "$cleaned" != "$pane_border" ]]; then
    while [[ "$cleaned" == *'  '* ]]; do
      cleaned="${cleaned//'  '/' '}"
    done
  fi
  printf '%s' "$cleaned"
}

_tmux_command_quote() {
  local value="$1"

  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

_set_status_labels() {
  local session="$1"
  local pane_border pane_border_cleaned status_left window window_border windows
  local option_rc rc=0

  _session_option_set "$session" status-left
  option_rc=$?
  if [[ "$option_rc" -ne 0 ]]; then
    [[ "$option_rc" -eq 1 ]] || rc=1
    if ! status_left=$(tmux show-options -gqv status-left 2>/dev/null); then
      status_left=""
      rc=1
    fi
    tmux set-option -t "$session" status-left \
      "$(_status_left_with_host "$status_left")" || rc=1
  fi

  if ! pane_border=$(tmux show-options -gqv pane-border-format 2>/dev/null); then
    pane_border=""
    rc=1
  fi
  pane_border_cleaned="$(_pane_border_without_host "$pane_border")"
  if [[ "$pane_border" != "$pane_border_cleaned" ]]; then
    tmux set-hook -t "$session" "$_DS_PANE_BORDER_HOOK" \
      "set-window-option pane-border-format $(_tmux_command_quote "$pane_border_cleaned")" || rc=1
    if ! windows=$(tmux list-windows -t "$session" -F '#{window_id}' 2>/dev/null); then
      windows=""
      rc=1
    fi
    while IFS= read -r window; do
      [[ -n "$window" ]] || continue
      _window_option_set "$window" pane-border-format
      option_rc=$?
      if [[ "$option_rc" -eq 0 ]]; then
        if ! window_border=$(tmux show-window-options -v -t "$window" pane-border-format 2>/dev/null); then
          rc=1
          continue
        fi
        [[ "$(_pane_border_without_host "$window_border")" != "$window_border" ]] || continue
      elif [[ "$option_rc" -ne 1 ]]; then
        rc=1
      fi
      tmux set-window-option -t "$window" pane-border-format "$pane_border_cleaned" || rc=1
    done <<<"$windows"
  fi

  return "$rc"
}

_session_shell_name() {
  local session="$1" value
  value=$(tmux show-environment -t "=$session" DS_SHELL_NAME 2>/dev/null) ||
    return 1
  [[ "$value" == DS_SHELL_NAME=* ]] || return 1
  value="${value#DS_SHELL_NAME=}"
  [[ "$value" =~ ^[A-Za-z0-9._+-]+$ ]] || return 1
  printf '%s\n' "$value"
}

_session_is_managed() {
  tmux show-environment -t "=$1" DS_MANAGED 2>/dev/null |
    grep -q '^DS_MANAGED='
}

_reconcile_ds_session() {
  local session="$1" session_id="$2" shell="$3"

  [[ "$shell" =~ ^[A-Za-z0-9._+-]+$ ]] || return 1
  tmux set-environment -t "$session" DS_MANAGED 1 || return 1
  tmux set-environment -t "$session" DS_SHELL_NAME "$shell" || return 1
  tmux set-option -t "$session" default-command \
    "$(_shell_login_cmd_for "$shell")" || return 1
  _set_status_labels "$session" || return 1
  tmux set-option -t "$session_id" @ds_status_labels_version \
    "$_DS_STATUS_LABELS_VERSION:$session_id"
}

_resurrect_dir() {
  local host path
  path=$(tmux show-options -gqv @resurrect-dir 2>/dev/null) || path=""
  if [[ -z "$path" ]]; then
    if [[ -d "$HOME/.tmux/resurrect" ]]; then
      path="$HOME/.tmux/resurrect"
    else
      path="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
    fi
  fi
  host=$(hostname)
  path="${path//\$HOME/$HOME}"
  path="${path//\$HOSTNAME/$host}"
  path="${path/#\~/$HOME}"
  printf '%s\n' "$path"
}

_resurrect_restore_expected() {
  local default_enabled enabled max_delay now server_start
  enabled=$(tmux show-options -gqv @continuum-restore 2>/dev/null) || enabled=""
  default_enabled=$(tmux show-options -gqv @ds-resurrect-auto-restore \
    2>/dev/null) || default_enabled=""
  [[ ("$enabled" == "on" || "$default_enabled" == "on") &&
    ! -f "$HOME/tmux_no_auto_restore" &&
    -f "$(_resurrect_dir)/last" ]] || return 1

  server_start=$(tmux display-message -p '#{start_time}' 2>/dev/null) || return 1
  max_delay=$(tmux show-options -gqv @continuum-restore-max-delay \
    2>/dev/null) || max_delay=""
  [[ "$max_delay" =~ ^[0-9]+$ ]] || max_delay=10
  now=$(_epoch_seconds) || return 1
  [[ "$server_start" =~ ^[0-9]+$ && "$now" =~ ^[0-9]+$ ]] || return 1
  ((server_start > now - max_delay))
}

_epoch_seconds() {
  date +%s
}

_wait_for_resurrect_restore() {
  local server_start="$1" marker restoring
  local start_attempts="${2:-30}" restore_attempts="${3:-300}"
  local attempts="$start_attempts"

  while ((attempts > 0)); do
    marker=$(tmux show-options -gqv @ds_resurrect_restored_at 2>/dev/null) ||
      marker=""
    [[ "$marker" == "$server_start" ]] && return 0
    restoring=$(tmux show-options -gqv @ds_resurrect_restoring_at 2>/dev/null) ||
      restoring=""
    [[ "$restoring" == "$server_start" ]] && break
    sleep 0.1
    attempts=$((attempts - 1))
  done
  [[ "$restoring" == "$server_start" ]] || return 1

  attempts="$restore_attempts"
  while ((attempts > 0)); do
    marker=$(tmux show-options -gqv @ds_resurrect_restored_at 2>/dev/null) ||
      marker=""
    [[ "$marker" == "$server_start" ]] && return 0
    sleep 0.1
    attempts=$((attempts - 1))
  done
  return 1
}

_do_resurrect_begin() {
  local server_start
  server_start=$(tmux display-message -p '#{start_time}') || return 1
  tmux set-option -g @ds_resurrect_restoring_at "$server_start"
}

_do_resurrect_save() {
  local file="$1" chmod_file records="" session shell

  [[ -f "$file" && ! -L "$file" ]] || return 1
  chmod_file="$file"
  [[ "$chmod_file" == -* ]] && chmod_file="./$chmod_file"
  chmod 0600 "$chmod_file" || return 1
  while IFS= read -r session; do
    [[ -n "$session" && "$session" != *$'\t'* ]] || continue
    _session_is_managed "$session" || continue
    shell=$(_session_shell_name "$session") || continue
    printf -v records '%sds-v1\t%s\t%s\n' "$records" "$session" "$shell"
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)

  [[ -z "$records" ]] || printf '%s' "$records" >>"$file"
}

_do_resurrect_restore() {
  local file="${1:-}" kind session shell extra session_id server_start
  [[ -n "$file" ]] || file="$(_resurrect_dir)/last"
  [[ -f "$file" ]] || return 1

  while IFS=$'\t' read -r kind session shell extra; do
    [[ "$kind" == "ds-v1" && -n "$session" && -z "$extra" ]] || continue
    [[ "$session" != *$'\n'* && "$shell" =~ ^[A-Za-z0-9._+-]+$ ]] || continue
    tmux has-session -t "=$session" 2>/dev/null || continue
    session_id=$(tmux display-message -p -t "=$session" '#{session_id}') ||
      continue
    _reconcile_ds_session "$session" "$session_id" "$shell" || continue
  done <"$file"

  server_start=$(tmux display-message -p '#{start_time}') || return 1
  tmux set-option -g @ds_resurrect_restored_at "$server_start"
}

_session_option_set() {
  local session="$1"
  local option="$2"
  local value

  value=$(tmux show-options -t "$session" -q "$option" 2>/dev/null) || return 2
  [[ -n "$value" ]]
}

_window_option_set() {
  local window="$1"
  local option="$2"
  local value

  value=$(tmux show-window-options -q -t "$window" "$option" 2>/dev/null) || return 2
  [[ -n "$value" ]]
}

# --- Session resolution helpers ---

# Resolve the current tmux session name, or error if not inside tmux.
_current_session() {
  if [[ -n "${TMUX:-}" ]]; then
    tmux display-message -p '#{session_name}'
  else
    echo "ds: session name required (not inside tmux)" >&2
    exit 1
  fi
}

# Resolve SESSION for actions that operate on existing sessions (kill, share,
# unshare).  Defaults to current tmux session if no session specified.
# Errors if remote (@host) without an explicit session name.
_resolve_session_target() {
  if [[ -n "$SESSION" ]]; then
    return
  fi
  if [[ -n "$HOST" ]]; then
    echo "ds: session name required for remote operations" >&2
    exit 1
  fi
  SESSION=$(_current_session) || exit 1
}

# Resolve PROFILE from SESSION for session creation.
# SESSION is a profile name (dev), a profile-instance (dev-work), or empty
# (defaults to the "ds" session with ds profile).
_resolve_profile() {
  if [[ -z "$SESSION" ]]; then
    SESSION="ds"
    PROFILE="ds"
    return
  fi
  # Check if SESSION itself is a profile name
  if declare -f "_profile_$SESSION" &>/dev/null; then
    PROFILE="$SESSION"
    return
  fi
  # Split on first dash — left side may be a profile
  local prefix="${SESSION%%-*}"
  if [[ "$prefix" != "$SESSION" ]] && declare -f "_profile_$prefix" &>/dev/null; then
    PROFILE="$prefix"
    return
  fi
  # Arbitrary name — use default "ds" profile
  PROFILE="ds"
}

# --- Actions ---

_do_list() {
  local shared_session=""
  if ! _share_obviously_inactive && _share_running; then
    shared_session=$(_share_current_session)
  fi
  # Fetch name + window/attach info for every session in ONE call. Re-running
  # `tmux ls` per session (to look up that session's info) made listing O(n^2)
  # in tmux subprocesses; one combined query is O(n) and reads the same fields.
  local all_sessions
  all_sessions=$(tmux ls -F '#{session_name}	#{session_windows} windows (#{?session_attached,attached,detached})' 2>/dev/null) || true
  [[ -z "$all_sessions" ]] && {
    echo "(no active ds sessions)"
    return
  }
  local output=""
  local name info
  while IFS=$'\t' read -r name info; do
    [[ -n "$name" ]] || continue
    if tmux show-environment -t "=$name" DS_MANAGED 2>/dev/null | grep -q '^DS_MANAGED='; then
      local line="$name: $info"
      if [[ "$name" == "$shared_session" ]]; then
        line="$line [shared]"
      fi
      output+="$line"$'\n'
    fi
  done <<<"$all_sessions"
  if [[ -z "$output" ]]; then
    echo "(no active ds sessions)"
  else
    printf '%s' "$output"
  fi
}

_do_kill() {
  local shared_session
  if tmux has-session -t "=$SESSION" 2>/dev/null; then
    shared_session=$(_share_current_session)
    if [[ "$shared_session" == "$SESSION" ]]; then
      _share_stop "$SESSION" || true
    fi
    tmux kill-session -t "=$SESSION"
    echo "killed $SESSION"
  else
    echo "ds: no session '$SESSION' — active sessions:" >&2
    _do_list >&2
    exit 1
  fi
}

_do_killall() {
  local shared_session
  shared_session=$(_share_current_session)
  if [[ -n "$shared_session" ]]; then
    _share_stop "$shared_session" || true
  fi

  local all_sessions
  all_sessions=$(tmux ls -F '#{session_name}' 2>/dev/null) || true
  [[ -z "$all_sessions" ]] && {
    echo "(no active ds sessions)"
    return
  }
  local found=0
  while IFS= read -r s; do
    if tmux show-environment -t "=$s" DS_MANAGED 2>/dev/null | grep -q '^DS_MANAGED='; then
      tmux kill-session -t "=$s"
      echo "killed $s"
      found=1
    fi
  done <<<"$all_sessions"
  if [[ "$found" -eq 0 ]]; then
    echo "(no active ds sessions)"
  fi
}

_do_share() {
  if [[ -n "$HOST" ]]; then
    echo "ds: --share is local only" >&2
    exit 1
  fi

  if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
    echo "ds: no session '$SESSION' to share — active sessions:" >&2
    _do_list >&2
    exit 1
  fi

  _share_start "$SESSION"
}

_do_unshare() {
  if [[ -n "$HOST" ]]; then
    echo "ds: --unshare is local only" >&2
    exit 1
  fi

  _share_stop "$SESSION"
}

_do_session_prepare() {
  local startup_restore="$1" sessions="$2"
  local marker name session_id
  while IFS=$'\t' read -r name session_id marker; do
    [[ "$name" == "$SESSION" ]] && break
    session_id=""
  done <<<"$sessions"

  # A second cold-start caller must not create another placeholder while
  # continuum is restoring the server started by the first caller.
  if [[ -z "$session_id" && -n "$sessions" && "$startup_restore" == "1" ]]; then
    local server_start
    server_start=$(tmux display-message -p '#{start_time}') || server_start=""
    [[ -z "$server_start" ]] || _wait_for_resurrect_restore "$server_start" || true
    sessions=$(tmux list-sessions -F $'#{session_name}\t#{session_id}\t#{@ds_status_labels_version}' \
      2>/dev/null) || sessions=""
    while IFS=$'\t' read -r name session_id marker; do
      [[ "$name" == "$SESSION" ]] && break
      session_id=""
    done <<<"$sessions"
  fi

  if [[ -n "$session_id" ]]; then
    if [[ -n "$session_id" && "$marker" != "$_DS_STATUS_LABELS_VERSION:$session_id" ]]; then
      if _session_is_managed "$SESSION"; then
        local existing_shell
        existing_shell=$(_session_shell_name "$SESSION") ||
          existing_shell="$(_shell_name)"
        # Publish the marker last: a failed setup stays unmarked and retries.
        _reconcile_ds_session "$SESSION" "$session_id" "$existing_shell" || true
      elif _set_status_labels "$SESSION"; then
        # Preserve native tmux ownership when ds attaches by name.
        tmux set-option -t "$session_id" @ds_status_labels_version \
          "$_DS_STATUS_LABELS_VERSION:$session_id" || true
      fi
    fi
    if [[ -n "${DS_SHARE_VIA:-}" ]]; then
      _share_start "$SESSION"
    fi
    return
  fi

  local shell_name shell_cmd
  shell_name="$(_shell_name)"
  shell_cmd="$(_shell_login_cmd)"
  session_id=$(tmux new-session -d -s "$SESSION" -P -F '#{session_id}' "$shell_cmd")
  if [[ "$startup_restore" == "detect" ]]; then
    startup_restore=0
    _resurrect_restore_expected && startup_restore=1
  fi
  if [[ "$startup_restore" == "1" ]]; then
    local server_start
    server_start=$(tmux display-message -p '#{start_time}') || server_start=""
    [[ -z "$server_start" ]] || _wait_for_resurrect_restore "$server_start" || true
  fi

  # A restore hook marks saved ds sessions before this point. Keep their
  # restored layout intact; otherwise finish the fresh bootstrap normally.
  if _session_is_managed "$SESSION"; then
    return
  fi

  _reconcile_ds_session "$SESSION" "$session_id" "$shell_name" || true
  "_profile_$PROFILE" "$SESSION"
  if [[ -n "${DS_SHARE_VIA:-}" ]]; then
    _share_start "$SESSION"
  fi
}

_resurrect_startup_lock_base() {
  local host root tmp
  host=$(hostname)
  host="${host//[^A-Za-z0-9._-]/_}"
  case "${XDG_RUNTIME_DIR:-}" in
    /*)
      root="${XDG_RUNTIME_DIR%/}/ds"
      ;;
    *)
      tmp=${TMPDIR:-/tmp}
      [[ "$tmp" == /* ]] || tmp=/tmp
      root="${tmp%/}/ds-$(id -u)"
      ;;
  esac
  printf '%s/resurrect-startup.%s\n' "$root" "$host"
}

_resurrect_startup_lock_paths() {
  local base generation now offset separator=""
  base=$(_resurrect_startup_lock_base) || return 1
  now=$(_epoch_seconds) || return 1
  [[ "$now" =~ ^[0-9]+$ ]] || return 1
  generation=$((now / 10))
  for offset in 0 1 2 3 4; do
    printf '%s%s.%s' "$separator" "$base" "$((generation + offset))"
    separator=$'\t'
  done
  printf '\n'
}

_acquire_resurrect_startup_lock_with_attempts() {
  local max_attempts="$1"
  local attempts=0 lock locks owner path root token
  root=$(_resurrect_startup_lock_base) || return 1
  root=${root%/*}
  [[ ! -L "$root" ]] || return 1
  (umask 077 && mkdir -p "$root") || return 1
  [[ -d "$root" && ! -L "$root" ]] || return 1
  owner=$(stat -c '%u' "$root" 2>/dev/null ||
    stat -f '%u' "$root" 2>/dev/null) || return 1
  [[ "$owner" == "$(id -u)" ]] || return 1
  chmod 0700 "$root" || return 1

  while ((attempts < max_attempts)); do
    IFS=$'\t' read -r -a locks < <(_resurrect_startup_lock_paths) || return 1
    token=""
    for path in "${locks[@]}"; do
      if mkdir -m 0700 "$path" 2>/dev/null; then
        if [[ -n "$token" ]]; then
          token+=$'\t'
        fi
        token+="$path"
      else
        _release_resurrect_startup_lock "$token" >/dev/null 2>&1 || true
        token=""
        break
      fi
    done
    if [[ -n "$token" && "${#locks[@]}" -eq 5 ]]; then
      printf '%s\n' "$token"
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 0.1
  done
  echo "ds: timed out waiting for tmux restore coordinator" >&2
  return 1
}

_acquire_resurrect_startup_lock() {
  _acquire_resurrect_startup_lock_with_attempts 600
}

_release_resurrect_startup_lock() {
  local token="$1" lock rc=0
  local locks=()
  [[ -n "$token" ]] || return 0
  IFS=$'\t' read -r -a locks <<<"$token"
  for lock in "${locks[@]}"; do
    rmdir "$lock" 2>/dev/null || rc=1
  done
  return "$rc"
}

_do_session_with_startup_lock() (
  local lock server_start sessions startup_restore=detect
  lock=$(_acquire_resurrect_startup_lock) || return 1
  trap '_release_resurrect_startup_lock "$lock" >/dev/null 2>&1 || true' EXIT

  # Requery after acquiring the host-scoped lock: another ds caller may
  # have created the bootstrap or completed restoration while we waited.
  sessions=$(tmux list-sessions -F $'#{session_name}\t#{session_id}\t#{@ds_status_labels_version}' \
    2>/dev/null) || sessions=""
  if [[ -n "$sessions" ]]; then
    startup_restore=0
    if _resurrect_restore_expected; then
      server_start=$(tmux display-message -p '#{start_time}') || server_start=""
      [[ -z "$server_start" ]] ||
        _wait_for_resurrect_restore "$server_start" || true
      sessions=$(tmux list-sessions -F $'#{session_name}\t#{session_id}\t#{@ds_status_labels_version}' \
        2>/dev/null) || sessions=""
    fi
  fi
  _do_session_prepare "$startup_restore" "$sessions"
)

_do_session() {
  # One compatibility-safe query provides existence, identity, and the
  # reconciliation marker without adding work per window on the warm path.
  local coordinate=0 marker name session_id sessions
  sessions=$(tmux list-sessions -F $'#{session_name}\t#{session_id}\t#{@ds_status_labels_version}' \
    2>/dev/null) || sessions=""
  while IFS=$'\t' read -r name session_id marker; do
    [[ "$name" == "$SESSION" ]] && break
    session_id=""
  done <<<"$sessions"

  if [[ -z "$session_id" ]]; then
    coordinate=1
  elif [[ "$marker" != "$_DS_STATUS_LABELS_VERSION:$session_id" ]] &&
    _resurrect_restore_expected; then
    coordinate=1
  fi

  if [[ "$coordinate" == "1" ]]; then
    _do_session_with_startup_lock || return
  else
    _do_session_prepare 0 "$sessions" || return
  fi

  [[ "$DS_NO_ATTACH" == "1" ]] || _attach "$SESSION"
}

_do_init() {
  local shell="${1:-}"
  if [[ -z "$shell" ]]; then
    echo "ds: init requires a shell name (e.g., ds init bash)" >&2
    exit 1
  fi
  case "$shell" in
    bash)
      cat <<'INIT_EOF'

ds() {
    DS_SHELL_NAME=bash command ds "$@"
}

# Connect handoff: attach-next lets connect plugins request a session
INIT_EOF
      _emit_handoff_file_contract
      cat <<'INIT_EOF'
if [[ $- == *i* && -f "$_ds_f" ]]; then
    _ds_args=()
    while IFS= read -r _ds_arg; do
        _ds_args+=("$_ds_arg")
    done < "$_ds_f"
    rm -f "$_ds_f"
INIT_EOF
      echo "    ((\${#_ds_args[@]} == 0)) || DS_SHELL_NAME=$shell exec ds \"\${_ds_args[@]}\""
      cat <<'INIT_EOF'
fi
unset _ds_f _ds_arg _ds_args

# Auto-attach on SSH login (opt-in via DS_SSH_AUTO_ATTACH, skip with NO_TMUX=1).
# Also requires a real terminal (SSH_TTY): a login with no controlling tty —
# e.g. an ET/command session holding a port-forward keepalive — is "interactive"
# but has no pty, and should not be hijacked by ds. A human ssh login gets a pty.
# DS_SSH_AUTO_ATTACH=ds      → attach to default "ds" session
# DS_SSH_AUTO_ATTACH=dev     → attach to "dev" session
# NO_TMUX=1                  → skip auto-attach for this login
if [[ -n "${DS_SSH_AUTO_ATTACH:-}" && -z "$TMUX" && $- == *i* && -n "$SSH_CONNECTION" && -z "$NO_TMUX" && -n "${SSH_TTY:-}" ]] && command -v tmux &>/dev/null; then
INIT_EOF
      echo "    DS_SHELL_NAME=$shell exec ds \"\$DS_SSH_AUTO_ATTACH\""
      cat <<'INIT_EOF'
fi

_ds() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    COMPREPLY=()

INIT_EOF
      _emit_completion_file_contract "    "
      cat <<'INIT_EOF'
    case "$prev" in
        init)
            COMPREPLY=($(compgen -W "bash zsh" -- "$cur"))
            return ;;
        -k|--kill|--share|--unshare)
            local sessions
            sessions=$(tmux ls -F '#{session_name}' 2>/dev/null | while IFS= read -r s; do
                tmux show-environment -t "=$s" DS_MANAGED 2>/dev/null | grep -q '^DS_MANAGED=' && echo "$s"
            done 2>/dev/null)
            COMPREPLY=($(compgen -W "$sessions" -- "$cur"))
            return ;;
        -c|--connect|--share-via|-L|--forward|-R|--reverse)
            return ;;
    esac

    if [[ "$cur" == @* ]]; then
        local hosts="" name _conn f
        for f in "$conf_dir"/$connect_config_glob; do
            [[ -f "$f" ]] || continue
            while read -r name _conn; do
                [[ -z "$name" || "$name" == '#'* ]] && continue
                [[ "$name" == *'*'* || "$name" == *'?'* ]] && continue
                hosts+=" @$name"
            done < "$f"
        done
        COMPREPLY=($(compgen -W "$hosts" -- "$cur"))
        return
    fi

    local profiles="" f pname
    for f in "$conf_dir"/$profile_script_glob; do
        [[ -f "$f" ]] || continue
        pname="${f##*/profile-}"; pname="${pname%.sh}"
        profiles+=" $pname"
    done
    for f in "$conf_dir"/$profile_config_glob; do
        [[ -f "$f" ]] || continue
        while read -r pname _rest; do
            [[ -z "$pname" || "$pname" == \#* ]] && continue
            profiles+=" $pname"
        done < "$f"
    done

    local sessions=""
    sessions=$(ds -l 2>/dev/null | while IFS=: read -r name _rest; do
        [[ "$name" == "("* ]] && continue
        echo "$name"
    done)

    # shellcheck disable=SC2086
    COMPREPLY=($(compgen -W \
        "--list --kill --killall --share --unshare --no-attach --connect --forward --reverse --share-via init --help$profiles $sessions" \
        -- "$cur"))
}
complete -F _ds ds
INIT_EOF
      ;;
    zsh)
      cat <<'INIT_EOF'

ds() {
    DS_SHELL_NAME=zsh command ds "$@"
}

# Connect handoff: attach-next lets connect plugins request a session
INIT_EOF
      _emit_handoff_file_contract
      cat <<'INIT_EOF'
if [[ -o interactive && -f "$_ds_f" ]]; then
    _ds_args=()
    while IFS= read -r _ds_arg; do
        _ds_args+=("$_ds_arg")
    done < "$_ds_f"
    rm -f "$_ds_f"
INIT_EOF
      echo "    ((\${#_ds_args[@]} == 0)) || DS_SHELL_NAME=$shell exec ds \"\${_ds_args[@]}\""
      cat <<'INIT_EOF'
fi
unset _ds_f _ds_arg _ds_args

# Auto-attach on SSH login (opt-in via DS_SSH_AUTO_ATTACH, skip with NO_TMUX=1).
# Also requires a real terminal (SSH_TTY): a login with no controlling tty —
# e.g. an ET/command session holding a port-forward keepalive — is "interactive"
# but has no pty, and should not be hijacked by ds. A human ssh login gets a pty.
# DS_SSH_AUTO_ATTACH=ds      → attach to default "ds" session
# DS_SSH_AUTO_ATTACH=dev     → attach to "dev" session
# NO_TMUX=1                  → skip auto-attach for this login
if [[ -n "${DS_SSH_AUTO_ATTACH:-}" && -z "$TMUX" && -o interactive && -n "$SSH_CONNECTION" && -z "$NO_TMUX" && -n "${SSH_TTY:-}" ]] && command -v tmux >/dev/null 2>&1; then
INIT_EOF
      echo "    DS_SHELL_NAME=$shell exec ds \"\$DS_SSH_AUTO_ATTACH\""
      cat <<'INIT_EOF'
fi

_ds() {
    local prev="${words[CURRENT-1]:-}"
    local cur="${words[CURRENT]:-}"
    local -a sessions hosts profiles options shells
    local f name _conn pname

INIT_EOF
      _emit_completion_file_contract "    "
      cat <<'INIT_EOF'
    shells=(bash zsh)
    options=(
        --list
        --kill
        --killall
        --share
        --unshare
        --no-attach
        --connect
        --forward
        --reverse
        --share-via
        init
        --help
    )

    case "$prev" in
        init)
            compadd -- "${shells[@]}"
            return
            ;;
        -k|--kill|--share|--unshare)
            sessions=(${(f)"$(tmux ls -F '#{session_name}' 2>/dev/null | while IFS= read -r s; do
                tmux show-environment -t "=$s" DS_MANAGED 2>/dev/null | grep -q '^DS_MANAGED=' && echo "$s"
            done 2>/dev/null)"})
            (( ${#sessions[@]} > 0 )) && compadd -- "${sessions[@]}"
            return
            ;;
        -c|--connect|--share-via|-L|--forward|-R|--reverse)
            return
            ;;
    esac

    if [[ "${words[2]:-}" == init ]]; then
        compadd -- "${shells[@]}"
        return
    fi

    if [[ "$cur" == @* ]]; then
        for f in "$conf_dir"/${~connect_config_glob}(N); do
            [[ -f "$f" ]] || continue
            while read -r name _conn; do
                [[ -z "$name" || "$name" == '#'* ]] && continue
                [[ "$name" == *'*'* || "$name" == *'?'* ]] && continue
                hosts+=("@$name")
            done < "$f"
        done
        (( ${#hosts[@]} > 0 )) && compadd -- "${hosts[@]}"
        return
    fi

    for f in "$conf_dir"/${~profile_script_glob}(N); do
        [[ -f "$f" ]] || continue
        pname="${f##*/profile-}"
        profiles+=("${pname%.sh}")
    done
    for f in "$conf_dir"/${~profile_config_glob}(N); do
        [[ -f "$f" ]] || continue
        while read -r pname _rest; do
            [[ -z "$pname" || "$pname" == \#* ]] && continue
            profiles+=("$pname")
        done < "$f"
    done

    sessions=(${(f)"$(ds -l 2>/dev/null | while IFS=: read -r name _rest; do
        [[ "$name" == "("* ]] && continue
        echo "$name"
    done)"})

    compadd -- "${options[@]}" "${profiles[@]}" "${sessions[@]}"
}
(( $+functions[compdef] )) && compdef _ds ds
INIT_EOF
      ;;
    *)
      echo "ds: unsupported shell '$shell' (supported: bash, zsh)" >&2
      exit 1
      ;;
  esac
}

# --- Remote dispatch ---

_remote_ds_command() {
  local args_q
  printf -v args_q '%q ' "$@"
  # shellcheck disable=SC2016 # These variables expand in the remote login shell.
  printf '%s' \
    'remote_ds=$(command -v ds 2>/dev/null) && [ -x "$remote_ds" ] || { printf "%s\n" "ds: not found on remote PATH" >&2; exit 127; }; ' \
    "exec \"\$remote_ds\" ${args_q}"
}

_remote() {
  lookup_host "$HOST"
  [[ -n "$CONNECT_OVERRIDE" ]] && CONNECT="$CONNECT_OVERRIDE"

  # Build the remote ds command args.
  local args=()
  local plugin_session="$SESSION"
  local remote_session="$SESSION"

  case "$ACTION" in
    list)
      args+=("-l")
      ;;
    kill)
      args+=("-k" "$SESSION")
      ;;
    killall)
      args+=("--killall")
      ;;
    session)
      remote_session="${SESSION:-ds}"
      plugin_session="$remote_session"
      args+=("$remote_session")
      [[ -n "${DS_SHARE_VIA:-}" ]] && args+=("--share-via" "$DS_SHARE_VIA")
      [[ "$DS_NO_ATTACH" == "1" ]] && args+=("--no-attach")
      ;;
  esac

  # Prefer the invoking shell on the remote side, but fall back to bash
  # when that shell is unavailable there.
  local remote_cmd shell remote_ds_cmd remote_ds_q
  shell="$(_shell_name)"
  remote_ds_cmd="$(_remote_ds_command "${args[@]}")"
  printf -v remote_ds_q '%q' "$remote_ds_cmd"
  if [[ "$shell" == "bash" ]]; then
    remote_cmd="NO_TMUX=1 DS_SHELL_NAME=bash bash -lc $remote_ds_q"
  else
    remote_cmd="if command -v $shell >/dev/null 2>&1; then NO_TMUX=1 DS_SHELL_NAME=$shell $shell -lc $remote_ds_q; else NO_TMUX=1 DS_SHELL_NAME=bash bash -lc $remote_ds_q; fi"
  fi

  # Build ssh -L / -R args. ssh needs the 3-part form `port:host:port`
  # (rejects 2-part). Specs follow ssh's native shorthand:
  #   DS_FORWARDS    = LOCAL:REMOTE (-L: bind LOCAL on client, target REMOTE on server)
  #   DS_R_FORWARDS  = REMOTE:LOCAL (-R: bind REMOTE on server, target LOCAL on client)
  # Both emit a `localhost` middle component, matching typical use.
  local -a ssh_fwd=()
  local fspec a b
  for fspec in "${FORWARDS[@]+"${FORWARDS[@]}"}"; do
    a="${fspec%%:*}"
    b="${fspec##*:}"
    ssh_fwd+=("-L" "${a}:localhost:${b}")
  done
  for fspec in "${R_FORWARDS[@]+"${R_FORWARDS[@]}"}"; do
    a="${fspec%%:*}"
    b="${fspec##*:}"
    ssh_fwd+=("-R" "${a}:localhost:${b}")
  done
  export DS_FORWARDS="${FORWARDS[*]+${FORWARDS[*]}}"
  export DS_R_FORWARDS="${R_FORWARDS[*]+${R_FORWARDS[*]}}"

  case "$CONNECT" in
    -)
      echo "ds: host '$HOST' is local-only (no remote connections)" >&2
      exit 1
      ;;
    ssh) exec ssh -t "${ssh_fwd[@]+"${ssh_fwd[@]}"}" -- "$HOST" "$remote_cmd" ;;
    *)
      local plugin
      plugin=$(_find_plugin "connect-${CONNECT}.sh") || {
        echo "ds: unknown connect method '$CONNECT' (no plugin found)" >&2
        exit 1
      }
      # shellcheck source=/dev/null
      . "$plugin"
      # The first five arguments are the stable plugin contract. Structured
      # arguments follow so transports can preserve exact boundaries.
      "_connect_${CONNECT}" "$HOST" "$remote_cmd" "$plugin_session" "$ACTION" \
        "${args[*]}" "${args[@]}"
      ;;
  esac
}

# --- Main ---

# When sourced for testing, export functions but skip arg parsing and execution.
if [[ -n "${DS_SOURCED:-}" ]]; then
  # shellcheck disable=SC2317
  return 0 2>/dev/null || exit 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c | --connect)
      [[ $# -ge 2 ]] || {
        echo "ds: $1 requires an argument" >&2
        exit 1
      }
      CONNECT_OVERRIDE="$2"
      shift 2
      ;;
    -L | --forward | -R | --reverse)
      [[ $# -ge 2 ]] || {
        echo "ds: $1 requires an argument" >&2
        exit 1
      }
      if [[ ! "$2" =~ ^[0-9]+:[0-9]+$ ]]; then
        echo "ds: invalid forward spec '$2' (expected LOCAL:REMOTE)" >&2
        exit 1
      fi
      case "$1" in
        -L | --forward) FORWARDS+=("$2") ;;
        -R | --reverse) R_FORWARDS+=("$2") ;;
      esac
      shift 2
      ;;
    --share-via)
      [[ $# -ge 2 ]] || {
        echo "ds: $1 requires an argument" >&2
        exit 1
      }
      DS_SHARE_VIA="$2"
      shift 2
      ;;
    --share)
      ACTION="share"
      shift
      ;;
    --unshare)
      ACTION="unshare"
      shift
      ;;
    --no-attach)
      DS_NO_ATTACH=1
      shift
      ;;
    -l | --list)
      ACTION="list"
      shift
      ;;
    -k | --kill)
      ACTION="kill"
      shift
      ;;
    --killall)
      ACTION="killall"
      shift
      ;;
    init)
      ACTION="init"
      if [[ $# -gt 1 && "$2" != -* && "$2" != @* ]]; then
        INIT_SHELL="$2"
        shift
      fi
      shift
      ;;
    resurrect)
      [[ $# -ge 2 ]] || {
        echo "ds: resurrect requires save, begin, or restore" >&2
        exit 1
      }
      case "$2" in
        save)
          [[ $# -eq 3 ]] || {
            echo "ds: resurrect save requires a snapshot file" >&2
            exit 1
          }
          ACTION="resurrect-save"
          RESURRECT_FILE="$3"
          shift 3
          ;;
        begin)
          [[ $# -eq 2 ]] || {
            echo "ds: resurrect begin takes no arguments" >&2
            exit 1
          }
          ACTION="resurrect-begin"
          shift 2
          ;;
        restore)
          [[ $# -le 3 ]] || {
            echo "ds: resurrect restore takes at most one snapshot file" >&2
            exit 1
          }
          ACTION="resurrect-restore"
          if [[ $# -eq 3 ]]; then
            RESURRECT_FILE="$3"
            shift
          fi
          shift 2
          ;;
        *)
          echo "ds: resurrect requires save, begin, or restore" >&2
          exit 1
          ;;
      esac
      ;;
    -h | --help)
      _usage
      exit 0
      ;;
    -*)
      _usage >&2
      exit 1
      ;;
    @*)
      HOST="${1#@}"
      shift
      ;;
    *)
      SESSION="$1"
      shift
      ;;
  esac
done

_ensure_state_dir

if [[ -z "$DS_SHARE_INFO_FILE" ]]; then
  DS_SHARE_INFO_FILE="$(_default_share_info_file)"
fi

# Load share backend if requested (by flag or for actions that need it)
if [[ -n "$DS_SHARE_VIA" ]]; then
  _load_share_backend "$DS_SHARE_VIA"
  _share_load_config
elif [[ "$ACTION" == "share" || "$ACTION" == "unshare" || "$ACTION" == "list" ||
  "$ACTION" == "kill" || "$ACTION" == "killall" ]]; then
  # Auto-detect active backend from state directory
  while IFS= read -r _sb; do
    [[ -n "$_sb" ]] || continue
    _sbn="${_sb##*/share-}"
    _sbn="${_sbn%.sh}"
    # shellcheck source=/dev/null
    . "$_sb"
    # Listing only annotates a shared session. A stable no-evidence observation
    # may omit an annotation for a concurrently starting share; mutating actions
    # always retain the backend's exact locked lifecycle probe.
    if [[ "$ACTION" == "list" ]] && _share_obviously_inactive; then
      _share_reset_stubs
      continue
    fi
    if _share_running 2>/dev/null; then
      DS_SHARE_VIA="$_sbn"
      _share_load_config
      break
    fi
    # Reset stubs if this backend isn't active
    _share_reset_stubs
  done < <(_share_backend_files)
  unset _sb _sbn
fi

# Validate: --killall and -l don't take a session name
if [[ "$ACTION" == "killall" && -n "$SESSION" ]]; then
  echo "ds: --killall does not take a session name (use -k to kill a single session)" >&2
  exit 1
fi
if [[ "$ACTION" == "list" && -n "$SESSION" ]]; then
  echo "ds: -l does not take a session name" >&2
  exit 1
fi

# Validate: init doesn't use @host
if [[ "$ACTION" == "init" && -n "$HOST" ]]; then
  echo "ds: init does not support remote hosts" >&2
  exit 1
fi

# Validate: -c without @host is meaningless
if [[ -n "$CONNECT_OVERRIDE" && -z "$HOST" ]]; then
  echo "ds: -c requires a remote host (@host)" >&2
  exit 1
fi

# Validate: -L/-R without @host is meaningless
if [[ ${#FORWARDS[@]} -gt 0 && -z "$HOST" ]]; then
  echo "ds: -L requires a remote host (@host)" >&2
  exit 1
fi
if [[ ${#R_FORWARDS[@]} -gt 0 && -z "$HOST" ]]; then
  echo "ds: -R requires a remote host (@host)" >&2
  exit 1
fi

# Resolve session/profile depending on the action
case "$ACTION" in
  session)
    if [[ -n "$HOST" ]]; then
      # Remote: skip local profile resolution — the remote ds handles it
      :
    else
      # Existing sessions ignore PROFILE in _do_session. Resolving here avoids a
      # separate tmux preflight before its authoritative exact session query.
      _resolve_profile
    fi
    ;;
  kill | share | unshare)
    _resolve_session_target
    ;;
esac

if [[ -n "$HOST" ]]; then
  _remote
  exit $?
fi

case "$ACTION" in
  init)
    _do_init "$INIT_SHELL"
    ;;
  list)
    _do_list
    ;;
  kill)
    _do_kill
    ;;
  killall)
    _do_killall
    ;;
  share)
    if [[ -z "$DS_SHARE_VIA" ]]; then
      # Auto-select if exactly one share backend is installed
      _backends=()
      while IFS= read -r _sb; do
        [[ -n "$_sb" ]] || continue
        _sbn="${_sb##*/share-}"
        _sbn="${_sbn%.sh}"
        _backends+=("$_sbn")
      done < <(_share_backend_files)
      if [[ ${#_backends[@]} -eq 1 ]]; then
        DS_SHARE_VIA="${_backends[0]}"
        _load_share_backend "$DS_SHARE_VIA"
        _share_load_config
      else
        echo "ds: --share-via <backend> required (available: ${_backends[*]:-none})" >&2
        exit 1
      fi
      unset _backends _sb _sbn
    fi
    _do_share
    ;;
  unshare)
    _do_unshare
    ;;
  resurrect-save)
    _do_resurrect_save "$RESURRECT_FILE"
    ;;
  resurrect-begin)
    _do_resurrect_begin
    ;;
  resurrect-restore)
    _do_resurrect_restore "$RESURRECT_FILE"
    ;;
  session)
    _do_session
    ;;
esac
